---
// Page loader component - shows during initial page load
---

<div id="page-loader" class="page-loader">
  <div class="loader-content">
    <div class="loader-spinner"></div>
    <p class="loader-text">Načítavam...</p>
  </div>
</div>

<style>
  .page-loader {
    position: fixed;
    inset: 0;
    background: oklch(0.99 0.002 180);
    display: none; /* Hidden by default */
    align-items: center;
    justify-content: center;
    z-index: 9999;
    opacity: 1;
    transition: opacity 0.3s ease-out;
    pointer-events: none;
  }

  .page-loader.show {
    display: flex; /* Only show when explicitly enabled */
  }

  .dark .page-loader {
    background: oklch(0.20 0.015 260);
  }

  .page-loader.loaded {
    opacity: 0;
  }

  .loader-content {
    text-align: center;
  }

  .loader-spinner {
    width: 48px;
    height: 48px;
    border: 4px solid oklch(0.55 0.12 195 / 0.2);
    border-top-color: oklch(0.55 0.12 195);
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
    margin: 0 auto 1rem;
  }

  .loader-text {
    color: oklch(0.25 0.015 260);
    font-weight: 500;
    font-size: 0.875rem;
  }

  .dark .loader-text {
    color: oklch(0.95 0.01 85);
  }

  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }

  /* Hide loader after page loads */
  @media (prefers-reduced-motion: reduce) {
    .loader-spinner {
      animation: none;
      border-top-color: oklch(0.55 0.12 195);
    }
  }
</style>

<script is:inline>
  // Show loader ONLY on true initial page load, never on View Transitions
  (function() {
    const loader = document.getElementById('page-loader');
    if (!loader) return;

    // Check if site has been visited in this session
    const hasVisited = sessionStorage.getItem('siteVisited');

    if (hasVisited) {
      // Already visited - keep loader hidden (default CSS is display:none)
      return;
    }

    // First visit - show loader and mark as visited
    loader.classList.add('show');
    sessionStorage.setItem('siteVisited', 'true');

    // Hide loader when page is fully loaded
    function hideLoader() {
      loader.classList.add('loaded');
      setTimeout(() => {
        loader.classList.remove('show');
      }, 300);
    }

    if (document.readyState === 'complete') {
      hideLoader();
    } else {
      window.addEventListener('load', hideLoader, { once: true });
    }

    // CRITICAL: Ensure loader never shows during View Transitions
    document.addEventListener('astro:before-preparation', function() {
      const l = document.getElementById('page-loader');
      if (l) {
        l.classList.remove('show');
        l.classList.remove('loaded');
      }
    });

    document.addEventListener('astro:after-swap', function() {
      const l = document.getElementById('page-loader');
      if (l) {
        l.classList.remove('show');
        l.classList.remove('loaded');
      }
    });
  })();
</script>
