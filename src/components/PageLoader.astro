---
// Page loader component - shows during initial page load
---

<div id="page-loader" class="page-loader">
  <div class="loader-content">
    <div class="loader-spinner"></div>
    <p class="loader-text">Načítavam...</p>
  </div>
</div>

<style>
  .page-loader {
    position: fixed;
    inset: 0;
    background: oklch(0.99 0.002 180);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 9999;
    opacity: 1;
    transition: opacity 0.3s ease-out;
    pointer-events: none;
  }

  .dark .page-loader {
    background: oklch(0.20 0.015 260);
  }

  .page-loader.loaded {
    opacity: 0;
  }

  .loader-content {
    text-align: center;
  }

  .loader-spinner {
    width: 48px;
    height: 48px;
    border: 4px solid oklch(0.55 0.12 195 / 0.2);
    border-top-color: oklch(0.55 0.12 195);
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
    margin: 0 auto 1rem;
  }

  .loader-text {
    color: oklch(0.25 0.015 260);
    font-weight: 500;
    font-size: 0.875rem;
  }

  .dark .loader-text {
    color: oklch(0.95 0.01 85);
  }

  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }

  /* Hide loader after page loads */
  @media (prefers-reduced-motion: reduce) {
    .loader-spinner {
      animation: none;
      border-top-color: oklch(0.55 0.12 195);
    }
  }
</style>

<script>
  // Hide loader when page is fully loaded
  window.addEventListener('load', () => {
    const loader = document.getElementById('page-loader');
    if (loader) {
      loader.classList.add('loaded');
      setTimeout(() => {
        loader.style.display = 'none';
      }, 300);
    }
  });

  // Also hide on DOMContentLoaded as fallback
  document.addEventListener('DOMContentLoaded', () => {
    const loader = document.getElementById('page-loader');
    if (loader && document.readyState === 'complete') {
      loader.classList.add('loaded');
      setTimeout(() => {
        loader.style.display = 'none';
      }, 300);
    }
  });
</script>
