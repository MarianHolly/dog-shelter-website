---
import { siteConfig } from '@/config/site.config';
import { Facebook, Instagram } from 'lucide-react';
---

<footer class="bg-foreground text-background dark:bg-background dark:text-foreground border-t border-border/40">
  <div class="mx-auto max-w-screen-2xl px-4 md:px-6 py-16 md:py-20">
    <!-- Desktop Layout (≥1024px) - 4 Column Grid -->
    <div class="hidden lg:grid lg:grid-cols-4 lg:gap-12">
      <!-- Column 1: Branding + Social Icons -->
      <div class="space-y-6">
        <div>
          <h2 class="text-2xl font-bold mb-3">{siteConfig.name}</h2>
          <p class="text-sm opacity-80 leading-relaxed">
            {siteConfig.description}
          </p>
        </div>

        <!-- Social Icons -->
        <div class="flex gap-4">
          {siteConfig.links.facebook && (
            <a
              href={siteConfig.links.facebook}
              class="flex items-center justify-center w-10 h-10 rounded-full bg-background/10 hover:bg-background/20 transition-all hover:scale-110"
              target="_blank"
              rel="noreferrer"
              aria-label="Facebook"
            >
              <Facebook className="size-5" />
            </a>
          )}
          {siteConfig.links.instagram && (
            <a
              href={siteConfig.links.instagram}
              class="flex items-center justify-center w-10 h-10 rounded-full bg-background/10 hover:bg-background/20 transition-all hover:scale-110"
              target="_blank"
              rel="noreferrer"
              aria-label="Instagram"
            >
              <Instagram className="size-5" />
            </a>
          )}
        </div>
      </div>

      <!-- Columns 2-4: Navigation Sections -->
      {
        siteConfig.footerNav.map((section) => (
          <div class="space-y-4">
            <h3 class="font-bold text-base">{section.title}</h3>
            <ul class="space-y-3">
              {section.items.map((item) => (
                <li>
                  <a
                    href={item.href}
                    class="text-sm opacity-80 hover:opacity-100 transition-opacity"
                    target={item.external ? '_blank' : undefined}
                    rel={item.external ? 'noreferrer' : undefined}
                  >
                    {item.title}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <!-- Tablet Layout (768px - 1024px) -->
    <div class="hidden md:block lg:hidden">
      <div class="space-y-10">
        <!-- Branding -->
        <div class="space-y-4">
          <h2 class="text-xl font-bold">{siteConfig.name}</h2>
          <p class="text-sm opacity-80 max-w-md leading-relaxed">
            {siteConfig.description}
          </p>

          <!-- Social Icons -->
          <div class="flex gap-4">
            {siteConfig.links.facebook && (
              <a
                href={siteConfig.links.facebook}
                class="flex items-center justify-center w-10 h-10 rounded-full bg-background/10 hover:bg-background/20 transition-all hover:scale-110"
                target="_blank"
                rel="noreferrer"
                aria-label="Facebook"
              >
                <Facebook className="size-5" />
              </a>
            )}
            {siteConfig.links.instagram && (
              <a
                href={siteConfig.links.instagram}
                class="flex items-center justify-center w-10 h-10 rounded-full bg-background/10 hover:bg-background/20 transition-all hover:scale-110"
                target="_blank"
                rel="noreferrer"
                aria-label="Instagram"
              >
                <Instagram className="size-5" />
              </a>
            )}
          </div>
        </div>

        <!-- Navigation Grid -->
        <div class="grid grid-cols-3 gap-8">
          {
            siteConfig.footerNav.map((section) => (
              <div class="space-y-4">
                <h3 class="font-bold text-sm">{section.title}</h3>
                <ul class="space-y-2">
                  {section.items.map((item) => (
                    <li>
                      <a
                        href={item.href}
                        class="text-sm opacity-80 hover:opacity-100 transition-opacity"
                        target={item.external ? '_blank' : undefined}
                        rel={item.external ? 'noreferrer' : undefined}
                      >
                        {item.title}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
      </div>
    </div>

    <!-- Mobile Layout (< 768px) -->
    <div class="md:hidden">
      <div class="space-y-8">
        <!-- Branding -->
        <div class="space-y-4 text-center">
          <h2 class="text-xl font-bold">{siteConfig.name}</h2>
          <p class="text-sm opacity-80 max-w-sm mx-auto leading-relaxed">
            {siteConfig.description}
          </p>
        </div>

        <!-- Navigation Grid -->
        <div class="grid grid-cols-2 gap-8">
          {
            siteConfig.footerNav.map((section) => (
              <div class="space-y-3">
                <h3 class="font-bold text-xs uppercase tracking-wider">{section.title}</h3>
                <ul class="space-y-2">
                  {section.items.map((item) => (
                    <li>
                      <a
                        href={item.href}
                        class="text-sm opacity-80 hover:opacity-100 transition-opacity"
                        target={item.external ? '_blank' : undefined}
                        rel={item.external ? 'noreferrer' : undefined}
                      >
                        {item.title}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>

        <!-- Social Icons -->
        <div class="flex items-center justify-center gap-4">
          {siteConfig.links.facebook && (
            <a
              href={siteConfig.links.facebook}
              class="flex items-center justify-center w-10 h-10 rounded-full bg-background/10 hover:bg-background/20 transition-all hover:scale-110"
              target="_blank"
              rel="noreferrer"
              aria-label="Facebook"
            >
              <Facebook className="size-5" />
            </a>
          )}
          {siteConfig.links.instagram && (
            <a
              href={siteConfig.links.instagram}
              class="flex items-center justify-center w-10 h-10 rounded-full bg-background/10 hover:bg-background/20 transition-all hover:scale-110"
              target="_blank"
              rel="noreferrer"
              aria-label="Instagram"
            >
              <Instagram className="size-5" />
            </a>
          )}
        </div>
      </div>
    </div>

    <!-- Footer Bottom -->
    <div class="mt-12 pt-8 border-t border-current/10">
      <div class="flex flex-col gap-2 text-center text-sm opacity-70 md:flex-row md:items-center md:justify-between">
        <p>{siteConfig.footer.copyright}</p>
        {siteConfig.footer.tagline && <p>{siteConfig.footer.tagline}</p>}
      </div>
    </div>
  </div>
</footer>
