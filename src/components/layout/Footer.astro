---
import { siteConfig } from '@/config/site.config';
// Brand icons removed from lucide-react v1 — using inline SVG (simpleicons.org)
---

<footer class="bg-foreground text-background dark:bg-background dark:text-foreground border-t border-border/40">
  <div class="mx-auto max-w-screen-2xl px-4 md:px-6 py-16 md:py-20">
    <!-- Desktop Layout (≥1024px) - 4 Column Grid -->
    <div class="hidden lg:grid lg:grid-cols-4 lg:gap-12">
      <!-- Column 1: Branding + Social Icons -->
      <div class="space-y-6">
        <div>
          <h2 class="text-2xl font-bold mb-3">{siteConfig.name}</h2>
          <p class="text-sm opacity-80 leading-relaxed">
            {siteConfig.description}
          </p>
        </div>

        <!-- Social Icons -->
        <div class="flex gap-4">
          {siteConfig.links.facebook && (
            <a
              href={siteConfig.links.facebook}
              class="flex items-center justify-center w-10 h-10 rounded-full bg-background/10 hover:bg-background/20 transition-all hover:scale-110"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Facebook"
            >
              <svg class="size-5" role="img" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
            </a>
          )}
          {siteConfig.links.instagram && (
            <a
              href={siteConfig.links.instagram}
              class="flex items-center justify-center w-10 h-10 rounded-full bg-background/10 hover:bg-background/20 transition-all hover:scale-110"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Instagram"
            >
              <svg class="size-5" role="img" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
            </a>
          )}
        </div>
      </div>

      <!-- Columns 2-4: Navigation Sections -->
      {
        siteConfig.footerNav.map((section) => (
          <div class="space-y-4">
            <h3 class="font-bold text-base">{section.title}</h3>
            <ul class="space-y-3">
              {section.items.map((item) => (
                <li>
                  <a
                    href={item.href}
                    class="text-sm opacity-80 hover:opacity-100 transition-opacity"
                    target={item.external ? '_blank' : undefined}
                    rel={item.external ? 'noopener noreferrer' : undefined}
                  >
                    {item.title}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <!-- Tablet Layout (768px - 1024px) -->
    <div class="hidden md:block lg:hidden">
      <div class="space-y-10">
        <!-- Branding -->
        <div class="space-y-4">
          <h2 class="text-xl font-bold">{siteConfig.name}</h2>
          <p class="text-sm opacity-80 max-w-md leading-relaxed">
            {siteConfig.description}
          </p>

          <!-- Social Icons -->
          <div class="flex gap-4">
            {siteConfig.links.facebook && (
              <a
                href={siteConfig.links.facebook}
                class="flex items-center justify-center w-10 h-10 rounded-full bg-background/10 hover:bg-background/20 transition-all hover:scale-110"
                target="_blank"
                rel="noopener noreferrer"
                aria-label="Facebook"
              >
                <svg class="size-5" role="img" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
              </a>
            )}
            {siteConfig.links.instagram && (
              <a
                href={siteConfig.links.instagram}
                class="flex items-center justify-center w-10 h-10 rounded-full bg-background/10 hover:bg-background/20 transition-all hover:scale-110"
                target="_blank"
                rel="noopener noreferrer"
                aria-label="Instagram"
              >
                <svg class="size-5" role="img" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
              </a>
            )}
          </div>
        </div>

        <!-- Navigation Grid -->
        <div class="grid grid-cols-3 gap-8">
          {
            siteConfig.footerNav.map((section) => (
              <div class="space-y-4">
                <h3 class="font-bold text-sm">{section.title}</h3>
                <ul class="space-y-2">
                  {section.items.map((item) => (
                    <li>
                      <a
                        href={item.href}
                        class="text-sm opacity-80 hover:opacity-100 transition-opacity"
                        target={item.external ? '_blank' : undefined}
                        rel={item.external ? 'noopener noreferrer' : undefined}
                      >
                        {item.title}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
      </div>
    </div>

    <!-- Mobile Layout (< 768px) -->
    <div class="md:hidden">
      <div class="space-y-8">
        <!-- Branding -->
        <div class="space-y-4 text-center">
          <h2 class="text-xl font-bold">{siteConfig.name}</h2>
          <p class="text-sm opacity-80 max-w-sm mx-auto leading-relaxed">
            {siteConfig.description}
          </p>
        </div>

        <!-- Navigation Grid -->
        <div class="grid grid-cols-2 gap-8">
          {
            siteConfig.footerNav.map((section) => (
              <div class="space-y-3">
                <h3 class="font-bold text-xs uppercase tracking-wider">{section.title}</h3>
                <ul class="space-y-2">
                  {section.items.map((item) => (
                    <li>
                      <a
                        href={item.href}
                        class="text-sm opacity-80 hover:opacity-100 transition-opacity"
                        target={item.external ? '_blank' : undefined}
                        rel={item.external ? 'noopener noreferrer' : undefined}
                      >
                        {item.title}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>

        <!-- Social Icons -->
        <div class="flex items-center justify-center gap-4">
          {siteConfig.links.facebook && (
            <a
              href={siteConfig.links.facebook}
              class="flex items-center justify-center w-10 h-10 rounded-full bg-background/10 hover:bg-background/20 transition-all hover:scale-110"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Facebook"
            >
              <svg class="size-5" role="img" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
            </a>
          )}
          {siteConfig.links.instagram && (
            <a
              href={siteConfig.links.instagram}
              class="flex items-center justify-center w-10 h-10 rounded-full bg-background/10 hover:bg-background/20 transition-all hover:scale-110"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Instagram"
            >
              <svg class="size-5" role="img" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
            </a>
          )}
        </div>
      </div>
    </div>

    <!-- Footer Bottom -->
    <div class="mt-12 pt-8 border-t border-current/10">
      <div class="flex flex-col gap-2 text-center text-sm opacity-70 md:flex-row md:items-center md:justify-between">
        <p>{siteConfig.footer.copyright}</p>
        {siteConfig.footer.tagline && <p>{siteConfig.footer.tagline}</p>}
      </div>
    </div>
  </div>
</footer>
