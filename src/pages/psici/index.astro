---
import MainLayout from '@/layouts/main.astro';
import { getCollection } from 'astro:content';
import DogFilters from '@/components/DogFilters';
import DogImage from '@/components/DogImage.astro';

// Get all dogs from content collection
const allDogs = await getCollection('dogs');
// Sort by urgent first, then by name
const dogs = allDogs.sort((a, b) => {
	if (a.data.urgent && !b.data.urgent) return -1;
	if (!a.data.urgent && b.data.urgent) return 1;
	return a.data.name.localeCompare(b.data.name);
});
---

<MainLayout title="Naši psíci" description="Spoznajte našich psíkov čakajúcich na nový domov">
	<!-- Header Section -->
	<section id="header" class="header-section section-spacing-sm">
		<div class="mx-auto max-w-7xl container-spacing">
			<div class="max-w-4xl mx-auto text-center space-y-6">
				<h1 class="text-4xl md:text-5xl lg:text-6xl font-bold tracking-tight">Naši psíci</h1>
				<p class="text-lg md:text-xl text-muted-foreground max-w-2xl mx-auto leading-relaxed">
					Títo úžasní psíci čakajú na nový domov a milujúcu rodinu. Každý z nich má svoj jedinečný príbeh a zaslúži si druhú šancu na šťastný život.
				</p>
			</div>
		</div>
	</section>

	<!-- Filters Section -->
	<section id="filters" class="filters-section pb-8">
		<div class="mx-auto max-w-7xl container-spacing">
			<div class="max-w-6xl mx-auto">
				<DogFilters client:load onFilterChange={(filters) => {}} />
			</div>
		</div>
	</section>

	<!-- Dogs Grid Section -->
	<section id="dogs-grid" class="dogs-grid-section section-spacing">
		<div class="mx-auto max-w-7xl container-spacing">
			<div id="dogs-container" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 md:gap-10">
				{dogs.map((dog) => (
					<a
						href={`/psici/${dog.id}`}
						class="dog-card group rounded-lg overflow-hidden bg-card shadow-minimal-hover transition-all duration-300 relative block"
						data-size={dog.data.size || ''}
						data-gender={dog.data.gender}
						data-energy={dog.data.energyLevel || ''}
						data-kids={dog.data.goodWithKids ? 'true' : 'false'}
						data-urgent={dog.data.urgent ? 'true' : 'false'}
					>
						{dog.data.urgent && (
							<div class="absolute top-3 right-3 z-10 bg-destructive text-white px-3 py-1.5 rounded-full text-xs font-bold shadow-md">
								⚡ URGENTNÉ
							</div>
						)}

						{/* Image - larger and more prominent */}
						<div class="relative overflow-hidden h-80 md:h-96">
							<DogImage
								src={dog.data.image}
								alt={dog.data.name}
								loading="lazy"
								aspectRatio="4/3"
								class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
							/>
							<div class="absolute inset-0 bg-linear-to-t from-background/80 via-background/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
						</div>

						<div class="p-5 space-y-3">
							{/* Name and Age on same line */}
							<div class="flex items-baseline justify-between gap-2">
								<h3 class="text-2xl font-bold tracking-tight">{dog.data.name}</h3>
								<span class="text-lg text-muted-foreground font-medium">{dog.data.age}</span>
							</div>

							{/* Breed */}
							<p class="text-sm text-muted-foreground">{dog.data.breed}</p>

							{/* Compact info row with icons */}
							<div class="flex items-center gap-4 pt-1 pb-2 text-muted-foreground">
								{/* Gender icon */}
								<div class="flex items-center gap-1.5" title={dog.data.gender}>
									<span class="text-xl">
										{dog.data.gender === 'Pes' ? '♂' : '♀'}
									</span>
								</div>

								{/* Size visualization with dog icons */}
								{dog.data.size && (
									<div class="flex items-center gap-1" title={dog.data.size}>
										<span class={`text-sm ${dog.data.size === 'Malý' ? 'text-primary' : 'text-muted-foreground/30'}`}>🐕</span>
										<span class={`text-base ${dog.data.size === 'Stredný' ? 'text-primary' : 'text-muted-foreground/30'}`}>🐕</span>
										<span class={`text-xl ${dog.data.size === 'Veľký' ? 'text-primary' : 'text-muted-foreground/30'}`}>🐕</span>
									</div>
								)}
							</div>

							{/* Short description - truncated */}
							<p class="text-sm text-foreground/80 leading-relaxed line-clamp-2">
								{dog.data.description}
							</p>

							{/* Badges - only most important ones */}
							<div class="flex flex-wrap gap-2 pt-2">
								{dog.data.goodWithKids && (
									<span class="px-2.5 py-1 bg-secondary/20 text-secondary-foreground text-xs rounded-full font-medium">
										👶 S deťmi
									</span>
								)}
								{dog.data.energyLevel === 'Nízka' && (
									<span class="px-2.5 py-1 bg-accent/20 text-accent-foreground text-xs rounded-full font-medium">
										😌 Pokojný
									</span>
								)}
							</div>

							{/* CTA appears on hover */}
							<div class="pt-3 opacity-0 group-hover:opacity-100 transition-opacity duration-300">
								<div class="w-full py-2.5 text-center rounded-md bg-primary/10 text-primary font-semibold text-sm group-hover:bg-primary/20 transition-colors">
									Viac informácií →
								</div>
							</div>
						</div>
					</a>
				))}
			</div>
		</div>
	</section>

	<!-- CTA Section -->
	<section id="cta" class="cta-section section-spacing-lg">
		<div class="mx-auto max-w-7xl container-spacing">
			<div class="max-w-4xl mx-auto bg-primary/5 rounded-lg p-10 md:p-12 text-center shadow-minimal">
				<h2 class="text-3xl md:text-4xl font-bold mb-6 tracking-tight">Nenašli ste svojho ideálneho kamaráta?</h2>
				<p class="text-lg text-muted-foreground mb-8 leading-relaxed max-w-2xl mx-auto">
					Kontaktujte nás priamo. Radi vám pomôžeme nájsť psíka, ktorý vám bude vyhovovať.
				</p>
				<a
					href="/kontakt"
					class="inline-flex items-center justify-center px-8 py-4 rounded-md bg-primary text-primary-foreground hover:bg-primary/90 transition-colors font-semibold text-lg shadow-sm"
				>
					Kontaktujte nás →
				</a>
			</div>
		</div>
	</section>

	<script is:inline>
		// Dog filtering functionality
		function applyFilters(filters) {
			console.log('Applying filters:', filters);
			const dogCards = document.querySelectorAll('.dog-card');
			let visibleCount = 0;

			dogCards.forEach((card) => {
				const cardElement = card;
				const cardSize = cardElement.dataset.size || '';
				const cardGender = cardElement.dataset.gender || '';
				const cardEnergy = cardElement.dataset.energy || '';
				const cardKids = cardElement.dataset.kids === 'true';
				const cardUrgent = cardElement.dataset.urgent === 'true';

				let show = true;

				// Size filter
				if (filters.size && cardSize !== filters.size) {
					show = false;
				}

				// Gender filter
				if (filters.gender && cardGender !== filters.gender) {
					show = false;
				}

				// Energy filter
				if (filters.energy && cardEnergy !== filters.energy) {
					show = false;
				}

				// Kids filter
				if (filters.goodWithKids && !cardKids) {
					show = false;
				}

				// Urgent filter
				if (filters.urgent && !cardUrgent) {
					show = false;
				}

				if (show) {
					cardElement.style.display = '';
					visibleCount++;
				} else {
					cardElement.style.display = 'none';
				}
			});

			// Show message if no dogs match
			const container = document.getElementById('dogs-container');
			if (container) {
				const existingMessage = container.querySelector('.no-results');
				if (existingMessage) {
					existingMessage.remove();
				}

				if (visibleCount === 0) {
					const message = document.createElement('div');
					message.className = 'no-results col-span-full text-center py-12';
					message.innerHTML = `
						<div class="space-y-4">
							<svg class="w-16 h-16 mx-auto text-muted-foreground/50" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
							</svg>
							<p class="text-xl font-semibold text-muted-foreground">Nenašli sa žiadni psíci</p>
							<p class="text-muted-foreground">Skúste upraviť filtre alebo ich zrušiť.</p>
						</div>
					`;
					container.appendChild(message);
				}
			}

			console.log('Visible dogs:', visibleCount);
		}

		// Expose the function globally so the React component can call it
		window.applyDogFilters = applyFilters;

		// Make sure function is available immediately
		console.log('Filter function registered:', typeof window.applyDogFilters);
	</script>
</MainLayout>
