---
import MainLayout from '@/layouts/main.astro';
import { getCollection, getEntry, render } from 'astro:content';
import { Markdown } from '@astropub/md';
import AdoptionInquiryForm from '@/components/forms/AdoptionInquiryForm';
import DogImage from '@/components/DogImage.astro';

// Get the slug from the URL
const { slug } = Astro.params;

// Get the dog entry from content collection
const dogEntry = await getEntry('dogs', slug as string);

// If dog not found, show 404
if (!dogEntry) {
	return Astro.redirect('/404');
}

const dog = dogEntry.data;
const markdownBody = dogEntry.body || '';

// Generate static paths for all dogs
export async function getStaticPaths() {
	const dogs = await getCollection('dogs');
	return dogs.map((dog) => ({
		params: { slug: dog.id },
	}));
}
---

<MainLayout title={dog.name} description={`Adoptujte si ${dog.name} - ${dog.breed}`}>
	<!-- Header Section -->
	<section id="header" class="header-section section-spacing-sm">
		<div class="mx-auto max-w-7xl container-spacing">
			<div class="max-w-6xl mx-auto">
				<a href="/psici" class="text-primary hover:text-primary/80 transition-colors mb-6 inline-flex items-center gap-2 font-medium">
					← Späť na všetkých psíkov
				</a>
				<div class="flex items-center gap-4 mt-6 flex-wrap">
					<h1 class="text-4xl md:text-5xl lg:text-6xl font-bold tracking-tight">{dog.name}</h1>
					<div class="flex gap-2 flex-wrap">
						{dog.urgent && (
							<span class="bg-destructive text-white px-4 py-1.5 rounded-full text-sm font-bold shadow-sm">
								⚡ URGENTNÉ
							</span>
						)}
						{dog.specialNeeds && (
							<span class="bg-accent text-accent-foreground px-4 py-1.5 rounded-full text-sm font-bold shadow-sm">
								💙 Špeciálne potreby
							</span>
						)}
						{dog.featured && (
							<span class="bg-secondary text-secondary-foreground px-4 py-1.5 rounded-full text-sm font-bold shadow-sm">
								⭐ Odporúčaný
							</span>
						)}
					</div>
				</div>
				<p class="text-lg md:text-xl text-muted-foreground mt-6 leading-relaxed max-w-4xl">{dog.description}</p>
			</div>
		</div>
	</section>

	<!-- Photo Gallery Section -->
	{dog.images && dog.images.length > 0 ? (
		<section id="gallery" class="gallery-section pb-8">
			<div class="mx-auto max-w-7xl container-spacing">
				<div class="max-w-6xl mx-auto">
					<div class="mb-6 flex justify-center rounded-lg overflow-hidden shadow-minimal-lg">
						<DogImage
							id="main-image"
							src={dog.images[0]}
							alt={`${dog.name} - hlavná fotka`}
							loading="eager"
							priority={true}
							aspectRatio="16/9"
							class="w-full h-auto max-h-[600px] object-cover"
						/>
					</div>
					<div class="grid grid-cols-4 md:grid-cols-6 lg:grid-cols-8 gap-3">
						{dog.images.map((image, index) => (
							<button
								class="thumbnail-btn overflow-hidden rounded-md border-2 border-transparent hover:border-primary transition-all cursor-pointer shadow-minimal"
								data-image={image}
							>
								<DogImage
									src={image}
									alt={`${dog.name} - fotka ${index + 1}`}
									loading="lazy"
									aspectRatio="4/3"
									class="w-full h-20 object-cover"
								/>
							</button>
						))}
					</div>
					{dog.videoUrl && (
						<div class="mt-8">
							<div class="aspect-video rounded-lg overflow-hidden shadow-minimal-lg">
								<iframe
									src={dog.videoUrl}
									class="w-full h-full"
									allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
									allowfullscreen
								></iframe>
							</div>
						</div>
					)}
				</div>
			</div>
		</section>
	) : (
		<section id="single-photo" class="single-photo-section pb-8">
			<div class="mx-auto max-w-7xl container-spacing">
				<div class="max-w-6xl mx-auto flex justify-center rounded-lg overflow-hidden shadow-minimal-lg">
					<img
						src={dog.image}
						alt={dog.name}
						loading="eager"
						fetchpriority="high"
						width="1200"
						height="600"
						class="w-full h-auto max-h-[600px] object-cover"
					/>
				</div>
				{dog.videoUrl && (
					<div class="mt-8">
						<div class="aspect-video rounded-lg overflow-hidden shadow-minimal-lg">
							<iframe
								src={dog.videoUrl}
								class="w-full h-full"
								allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
								allowfullscreen
							></iframe>
						</div>
					</div>
				)}
			</div>
		</section>
	)}

	<!-- Main Info Section -->
	<section id="main-info" class="main-info-section section-spacing">
		<div class="mx-auto max-w-7xl container-spacing">
			<div class="max-w-6xl mx-auto">
				<div class="grid lg:grid-cols-[300px_1fr] gap-10 md:gap-12">
					<!-- Left Sidebar - Quick Info -->
					<div class="space-y-6">
						<!-- Quick Info Card -->
						<div class="p-6 rounded-lg bg-card shadow-minimal">
							<h2 class="text-xl font-semibold mb-5 tracking-tight">Rýchle info</h2>
							<dl class="space-y-3 text-sm">
								<div class="flex justify-between py-2">
									<dt class="text-muted-foreground">Plemeno</dt>
									<dd class="font-medium text-right">{dog.breed}</dd>
								</div>
								<div class="flex justify-between py-2">
									<dt class="text-muted-foreground">Vek</dt>
									<dd class="font-medium">{dog.age}</dd>
								</div>
								<div class="flex justify-between py-2">
									<dt class="text-muted-foreground">Pohlavie</dt>
									<dd class="font-medium">{dog.gender}</dd>
								</div>
								{dog.size && (
									<div class="flex justify-between py-2">
										<dt class="text-muted-foreground">Veľkosť</dt>
										<dd class="font-medium">{dog.size}</dd>
									</div>
								)}
								{dog.weight && (
									<div class="flex justify-between py-2">
										<dt class="text-muted-foreground">Hmotnosť</dt>
										<dd class="font-medium">{dog.weight}</dd>
									</div>
								)}
								{dog.color && (
									<div class="flex justify-between py-2">
										<dt class="text-muted-foreground">Farba</dt>
										<dd class="font-medium">{dog.color}</dd>
									</div>
								)}
								{dog.energyLevel && (
									<div class="flex justify-between py-2">
										<dt class="text-muted-foreground">Energia</dt>
										<dd class="font-medium">{dog.energyLevel}</dd>
									</div>
								)}
								{dog.arrivalDate && (
									<div class="flex justify-between py-2">
										<dt class="text-muted-foreground">V útulku od</dt>
										<dd class="font-medium text-right">{dog.arrivalDate}</dd>
									</div>
								)}
							</dl>
						</div>

						<!-- Health Card -->
						<div class="p-6 rounded-lg bg-card shadow-minimal">
							<h2 class="text-xl font-semibold mb-5 tracking-tight">Zdravie</h2>
							<div class="space-y-3 text-sm">
								<div class="flex items-center gap-3">
									<span class={dog.vaccinated ? 'text-primary' : 'text-muted-foreground/40'}>
										{dog.vaccinated ? '✓' : '○'}
									</span>
									<span>Očkovaný</span>
								</div>
								<div class="flex items-center gap-3">
									<span class={dog.sterilized ? 'text-primary' : 'text-muted-foreground/40'}>
										{dog.sterilized ? '✓' : '○'}
									</span>
									<span>Kastrovaný/Sterilizovaná</span>
								</div>
								<div class="flex items-center gap-3">
									<span class={dog.chipped ? 'text-primary' : 'text-muted-foreground/40'}>
										{dog.chipped ? '✓' : '○'}
									</span>
									<span>Čipovaný</span>
								</div>
								<div class="flex items-center gap-3">
									<span class={dog.dewormed ? 'text-primary' : 'text-muted-foreground/40'}>
										{dog.dewormed ? '✓' : '○'}
									</span>
									<span>Odčervený</span>
								</div>
							</div>
							{dog.health && (
								<div class="mt-5 pt-5 border-t border-border/50">
									<p class="text-sm text-muted-foreground leading-relaxed">{dog.health}</p>
								</div>
							)}
							{dog.healthIssues && (
								<div class="mt-5 pt-5 border-t border-border/50">
									<p class="text-sm leading-relaxed"><strong class="text-accent">Poznámka:</strong> {dog.healthIssues}</p>
								</div>
							)}
							{dog.medications && dog.medications.length > 0 && (
								<div class="mt-5 pt-5 border-t border-border/50">
									<p class="text-sm font-medium mb-2">Lieky:</p>
									<ul class="text-sm text-muted-foreground space-y-1">
										{dog.medications.map((med) => <li class="flex items-start gap-2"><span class="text-primary">•</span> {med}</li>)}
									</ul>
								</div>
							)}
							{dog.dietaryNeeds && (
								<div class="mt-5 pt-5 border-t border-border/50">
									<p class="text-sm"><strong>Strava:</strong> {dog.dietaryNeeds}</p>
								</div>
							)}
						</div>

						<!-- Adoption Info Card -->
						{(dog.adoptionFee || (dog.specialRequirements && dog.specialRequirements.length > 0)) && (
							<div class="p-6 rounded-lg bg-primary/5 shadow-minimal">
								<h2 class="text-xl font-semibold mb-5 tracking-tight">Adopcia</h2>
								{dog.adoptionFee && (
									<div class="mb-4">
										<p class="text-sm text-muted-foreground mb-2">Poplatok</p>
										<p class="text-3xl font-bold text-primary">{dog.adoptionFee} €</p>
										<p class="text-xs text-muted-foreground mt-2 leading-relaxed">Zahŕňa očkovanie, čipovanie, kastráciu a veterinárnu starostlivosť</p>
									</div>
								)}
								{dog.specialRequirements && dog.specialRequirements.length > 0 && (
									<div class="mt-5 pt-5 border-t border-primary/20">
										<p class="font-medium text-sm mb-3">Špeciálne požiadavky:</p>
										<ul class="space-y-2 text-sm">
											{dog.specialRequirements.map((req) => (
												<li class="flex items-start gap-2">
													<span class="text-primary mt-0.5">→</span>
													<span class="leading-relaxed">{req}</span>
												</li>
											))}
										</ul>
									</div>
								)}
							</div>
						)}
					</div>

					<!-- Main Content - Flowing Information -->
					<div class="space-y-10">
						<!-- Story: Personality + Markdown combined -->
						{(dog.personality || markdownBody) && (
							<div class="prose prose-lg dark:prose-invert max-w-none">
								<h2 class="text-3xl md:text-4xl font-bold mb-6 tracking-tight">Príbeh {dog.name}</h2>
								{dog.personality && (
									<p class="text-lg leading-relaxed text-muted-foreground mb-6">{dog.personality}</p>
								)}
								{markdownBody && (
									<div class="leading-relaxed" set:html={markdownBody} />
								)}
							</div>
						)}

						{dog.characteristics && dog.characteristics.length > 0 && (
							<div>
								<h3 class="text-2xl font-bold mb-5 tracking-tight">Charakteristika</h3>
								<ul class="grid md:grid-cols-2 gap-3">
									{dog.characteristics.map((char) => (
										<li class="flex items-start gap-3 text-base">
											<span class="text-primary mt-1">•</span>
											<span>{char}</span>
										</li>
									))}
								</ul>
							</div>
						)}

						<!-- Compatibility -->
						{(dog.goodWithKids !== undefined || dog.goodWithDogs !== undefined || dog.goodWithCats !== undefined || dog.goodWithOtherPets !== undefined) && (
							<div>
								<h3 class="text-2xl font-bold mb-5 tracking-tight">Kompatibilita</h3>
								<div class="grid md:grid-cols-2 gap-4">
									{dog.goodWithKids !== undefined && (
										<div class="flex items-start gap-3 p-5 rounded-lg bg-card shadow-minimal">
											<span class={dog.goodWithKids ? 'text-primary text-xl' : 'text-muted-foreground/40 text-xl'}>
												{dog.goodWithKids ? '✓' : '○'}
											</span>
											<div>
												<span class="font-semibold">S deťmi</span>
												{dog.kidsAgeRecommendation && (
													<p class="text-sm text-muted-foreground mt-1 leading-relaxed">{dog.kidsAgeRecommendation}</p>
												)}
											</div>
										</div>
									)}
									{dog.goodWithDogs !== undefined && (
										<div class="flex items-start gap-3 p-5 rounded-lg bg-card shadow-minimal">
											<span class={dog.goodWithDogs ? 'text-primary text-xl' : 'text-muted-foreground/40 text-xl'}>
												{dog.goodWithDogs ? '✓' : '○'}
											</span>
											<span class="font-semibold">S inými psami</span>
										</div>
									)}
									{dog.goodWithCats !== undefined && (
										<div class="flex items-start gap-3 p-5 rounded-lg bg-card shadow-minimal">
											<span class={dog.goodWithCats ? 'text-primary text-xl' : 'text-muted-foreground/40 text-xl'}>
												{dog.goodWithCats ? '✓' : '○'}
											</span>
											<span class="font-semibold">S mačkami</span>
										</div>
									)}
									{dog.goodWithOtherPets !== undefined && (
										<div class="flex items-start gap-3 p-5 rounded-lg bg-card shadow-minimal">
											<span class={dog.goodWithOtherPets ? 'text-primary text-xl' : 'text-muted-foreground/40 text-xl'}>
												{dog.goodWithOtherPets ? '✓' : '○'}
											</span>
											<span class="font-semibold">S inými zvieratami</span>
										</div>
									)}
								</div>
							</div>
						)}

						{/* Training */}
						{(dog.houseTrained !== undefined || dog.leashTrained !== undefined || (dog.commands && dog.commands.length > 0) || dog.trainingNeeds) && (
							<div>
								<h3 class="text-2xl font-bold mb-5 tracking-tight">Výcvik a zručnosti</h3>
								<div class="space-y-5">
									<div class="grid md:grid-cols-2 gap-4">
										{dog.houseTrained !== undefined && (
											<div class="flex items-center gap-3 p-5 rounded-lg bg-card shadow-minimal">
												<span class={dog.houseTrained ? 'text-primary text-lg' : 'text-muted-foreground/40 text-lg'}>
													{dog.houseTrained ? '✓' : '○'}
												</span>
												<span class="font-medium">Čistotný</span>
											</div>
										)}
										{dog.leashTrained !== undefined && (
											<div class="flex items-center gap-3 p-5 rounded-lg bg-card shadow-minimal">
												<span class={dog.leashTrained ? 'text-primary text-lg' : 'text-muted-foreground/40 text-lg'}>
													{dog.leashTrained ? '✓' : '○'}
												</span>
												<span class="font-medium">Chodí na vodítku</span>
											</div>
										)}
									</div>
									{dog.commands && dog.commands.length > 0 && (
										<div class="p-5 rounded-lg bg-card shadow-minimal">
											<p class="font-medium mb-3">Ovláda povely:</p>
											<div class="flex flex-wrap gap-2">
												{dog.commands.map((cmd) => (
													<span class="px-4 py-2 bg-primary/10 text-primary rounded-full font-medium text-sm">
														{cmd}
													</span>
												))}
											</div>
										</div>
									)}
									{dog.trainingNeeds && (
										<p class="text-muted-foreground leading-relaxed">{dog.trainingNeeds}</p>
									)}
								</div>
							</div>
						)}

						{/* Living Requirements */}
						{(dog.exerciseNeeds || dog.spaceNeeds || dog.timeCommitment || dog.experienceRequired || dog.aloneTimeTolerance || dog.groomingNeeds) && (
							<div>
								<h3 class="text-2xl font-bold mb-5 tracking-tight">Čo {dog.name} potrebuje</h3>
								<div class="grid md:grid-cols-2 gap-4">
									{dog.exerciseNeeds && (
										<div class="p-5 rounded-lg bg-card shadow-minimal">
											<dt class="font-medium text-sm text-muted-foreground mb-2">Potreba pohybu</dt>
											<dd>{dog.exerciseNeeds}</dd>
										</div>
									)}
									{dog.spaceNeeds && (
										<div class="p-5 rounded-lg bg-card shadow-minimal">
											<dt class="font-medium text-sm text-muted-foreground mb-2">Priestor</dt>
											<dd>{dog.spaceNeeds}</dd>
										</div>
									)}
									{dog.timeCommitment && (
										<div class="p-5 rounded-lg bg-card shadow-minimal">
											<dt class="font-medium text-sm text-muted-foreground mb-2">Časová náročnosť</dt>
											<dd>{dog.timeCommitment}</dd>
										</div>
									)}
									{dog.experienceRequired && (
										<div class="p-5 rounded-lg bg-card shadow-minimal">
											<dt class="font-medium text-sm text-muted-foreground mb-2">Potrebné skúsenosti</dt>
											<dd>
												<span class={`px-4 py-1.5 rounded-full font-medium inline-block text-sm ${
													dog.experienceRequired === 'Začiatočník' ? 'bg-secondary/20 text-secondary-foreground' :
													dog.experienceRequired === 'Stredne pokročilý' ? 'bg-accent/20 text-accent-foreground' :
													'bg-primary/20 text-primary'
												}`}>
													{dog.experienceRequired}
												</span>
											</dd>
										</div>
									)}
									{dog.aloneTimeTolerance && (
										<div class="p-5 rounded-lg bg-card shadow-minimal">
											<dt class="font-medium text-sm text-muted-foreground mb-2">Tolerancia samoty</dt>
											<dd>{dog.aloneTimeTolerance}</dd>
										</div>
									)}
									{dog.groomingNeeds && (
										<div class="p-5 rounded-lg bg-card shadow-minimal">
											<dt class="font-medium text-sm text-muted-foreground mb-2">Starostlivosť o srsť</dt>
											<dd>{dog.groomingNeeds}</dd>
										</div>
									)}
								</div>
							</div>
						)}

						{/* Ideal Home */}
						{dog.idealFamily && (
							<div class="p-8 rounded-lg bg-primary/5 shadow-minimal">
								<h3 class="text-2xl font-bold mb-5 tracking-tight">Ideálny domov</h3>
								<p class="text-lg leading-relaxed">{dog.idealFamily}</p>
							</div>
						)}

						{/* Why Adopt Me */}
						{dog.whyAdoptMe && dog.whyAdoptMe.length > 0 && (
							<div class="p-8 rounded-lg bg-secondary/5 shadow-minimal">
								<h3 class="text-2xl font-bold mb-5 tracking-tight">Prečo si ma adoptovať?</h3>
								<ul class="space-y-3">
									{dog.whyAdoptMe.map((reason) => (
										<li class="flex items-start gap-3 text-base">
											<span class="text-primary mt-1">•</span>
											<span class="leading-relaxed">{reason}</span>
										</li>
									))}
								</ul>
							</div>
						)}
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- CTA Section -->
	<section id="cta" class="cta-section section-spacing-lg">
		<div class="mx-auto max-w-7xl container-spacing">
			<div class="max-w-4xl mx-auto bg-primary/5 rounded-lg p-10 md:p-12 text-center shadow-minimal">
				<h2 class="text-3xl md:text-4xl font-bold mb-6 tracking-tight">Chcete adoptovať {dog.name}?</h2>
				<p class="text-lg text-muted-foreground mb-10 leading-relaxed max-w-2xl mx-auto">
					{dog.name} čaká na svoj nový domov plný lásky. Navštívte nás v útulku alebo nás kontaktujte pre viac informácií o adopcii.
				</p>
				<div class="flex flex-col sm:flex-row gap-4 justify-center">
					<a
						href="/adopcia"
						class="inline-flex items-center justify-center px-8 py-4 rounded-md bg-primary text-primary-foreground hover:bg-primary/90 transition-colors font-semibold shadow-sm"
					>
						Ako adoptovať
					</a>
					<a
						href="/kontakt"
						class="inline-flex items-center justify-center px-8 py-4 rounded-md bg-secondary text-secondary-foreground hover:bg-secondary/90 transition-colors font-semibold shadow-sm"
					>
						Kontaktujte nás
					</a>
				</div>
				<div class="mt-10 pt-10 border-t border-border/50">
					<p class="text-sm text-muted-foreground leading-relaxed">
						<strong>Otváracie hodiny:</strong> Pondelok - Nedeľa, 10:00 - 16:00<br />
						<strong>Telefón:</strong> <a href="tel:+421915785007" class="text-primary hover:text-primary/80 transition-colors">+421 915 785 007</a>
					</p>
				</div>
			</div>
		</div>
	</section>

	<!-- Adoption Inquiry Form Section -->
	<section id="adoption-inquiry" class="adoption-inquiry-section section-spacing bg-muted/5">
		<div class="mx-auto max-w-7xl container-spacing">
			<div class="max-w-2xl mx-auto">
				<h2 class="text-3xl md:text-4xl font-bold mb-6 tracking-tight">Mám záujem o adopciu</h2>
				<p class="text-lg text-muted-foreground mb-10 leading-relaxed">
					Chcete adoptovať {dog.name}? Vyplňte formulár a my sa vám ozveme s ďalšími informáciami o adopčnom procese.
				</p>
				<AdoptionInquiryForm
					dogName={dog.name}
					dogSlug={slug as string}
					client:load
				/>
			</div>
		</div>
	</section>

	<!-- Photo Gallery JavaScript -->
	<script>
		// Photo gallery functionality
		const mainImage = document.getElementById('main-image');
		const thumbnailButtons = document.querySelectorAll('.thumbnail-btn');

		thumbnailButtons.forEach((button) => {
			button.addEventListener('click', () => {
				const newImage = button.getAttribute('data-image');
				if (mainImage && newImage) {
					mainImage.setAttribute('src', newImage);

					// Update active state
					thumbnailButtons.forEach((btn) => btn.classList.remove('border-primary'));
					button.classList.add('border-primary');
				}
			});
		});

		// Set first thumbnail as active on load
		if (thumbnailButtons.length > 0) {
			thumbnailButtons[0].classList.add('border-primary');
		}
	</script>
</MainLayout>
