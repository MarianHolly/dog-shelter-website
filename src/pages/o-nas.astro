---
import MainLayout from '@/layouts/main.astro';
import NewsletterForm from '@/components/forms/NewsletterForm';
---

<MainLayout title="O nás" description="Spoznajte Trenčianský útulok, náš tím a našu misiu pomáhať opusteným a týraným psom nájsť nový domov.">
	<!-- Hero Section -->
	<section id="hero" class="hero-section relative overflow-hidden h-[500px] flex items-center justify-center">
		<!-- Background Image -->
		<div class="absolute inset-0 z-0">
			<img
				src="/images/james-lacy-unsplash.jpg"
				alt="Trenčianský útulok"
				class="w-full h-full object-cover"
			/>
			<div class="absolute inset-0 bg-black/50"></div>
		</div>

		<!-- Content -->
		<div class="relative z-10 mx-auto max-w-7xl px-4">
			<div class="max-w-4xl mx-auto text-center space-y-6">
				<h1 class="text-4xl md:text-6xl font-bold text-white">O nás</h1>
				<p class="text-xl md:text-2xl text-white/90 leading-relaxed">
					Od roku 2011 zachraňujeme opustené životy a tvoríme šťastné príbehy.<br>
					Spoznajte náš príbeh, tím a hodnoty, ktorými sa riadime.
				</p>
			</div>
		</div>
	</section>

	<!-- História Section -->
	<section id="historia" class="historia-section">
		<div class="mx-auto max-w-7xl px-4 py-20">
			<div class="max-w-5xl mx-auto">
				<div class="flex items-center gap-4 mb-12">
					<div class="text-5xl">📖</div>
					<h2 class="text-3xl md:text-4xl font-bold">Naša história</h2>
				</div>

				<div class="grid md:grid-cols-3 gap-8 mb-12">
					<div class="text-center p-6">
						<div class="text-5xl font-bold text-primary mb-2">2011</div>
						<p class="text-lg text-muted-foreground">Rok založenia</p>
					</div>
					<div class="text-center p-6">
						<div class="text-5xl font-bold text-primary mb-2">30+</div>
						<p class="text-lg text-muted-foreground">Adoptovaných psíkov</p>
					</div>
					<div class="text-center p-6">
						<div class="text-5xl font-bold text-primary mb-2">13</div>
						<p class="text-lg text-muted-foreground">Rokov skúseností</p>
					</div>
				</div>

				<div class="space-y-8 text-lg leading-relaxed">
					<p class="text-muted-foreground">
						Občianske združenie Trenčianský útulok je <strong>malý, lokálny útulok</strong> s jasným cieľom - pomáhať opusteným a týraným psom v našom regióne nájsť nový domov plný lásky a starostlivosti.
					</p>

					<div class="bg-primary/5 border-l-4 border-primary rounded-r-lg p-6">
						<p class="text-muted-foreground">
							Od <strong class="text-primary">1. októbra 2011</strong> spravujeme karanténnu stanicu v Trenčíne. Po rozsiahlej rekonštrukcii a dostavbe sme otvorili aj útulok pre psíkov. Hoci sme malý útulok, každý zachránený život má pre nás obrovskú hodnotu.
						</p>
					</div>

					<p class="text-muted-foreground">
						Za tie roky sme pomohli desatkám psíkov nájsť ich „navždy domov". Každý príbeh je jedinečný, každý psík má svoj osud a my sme tu, aby sme im pomohli napísať šťastný koniec. <strong>Aj malý čin pomoci má veľkú hodnotu.</strong>
					</p>
				</div>
			</div>
		</div>
	</section>

	<!-- Misia Section -->
	<section id="misia" class="misia-section bg-muted/10">
		<div class="mx-auto max-w-7xl px-4 py-20">
			<div class="max-w-5xl mx-auto">
				<div class="flex items-center gap-4 mb-12">
					<div class="text-5xl">🎯</div>
					<h2 class="text-3xl md:text-4xl font-bold">Naša misia</h2>
				</div>

				<div class="grid md:grid-cols-2 gap-12 mb-12">
					<div>
						<h3 class="text-2xl font-semibold mb-6">Náš hlavný cieľ</h3>
						<p class="text-lg text-muted-foreground leading-relaxed mb-6">
							<strong>Pomôcť nájsť domov opusteným a týraným psom.</strong> Veríme, že každý pes si zaslúži druhú šancu, lásku a bezpečie.
						</p>
					</div>

					<div>
						<h3 class="text-2xl font-semibold mb-6">Čo robíme</h3>
						<ul class="space-y-4 text-lg">
							<li class="flex items-start gap-3">
								<span class="text-primary text-xl">✓</span>
								<span class="text-muted-foreground">Zabezpečujeme kvalitné útočisko pre opustené a týrané psy</span>
							</li>
							<li class="flex items-start gap-3">
								<span class="text-primary text-xl">✓</span>
								<span class="text-muted-foreground">Poskytujeme veterinárnu starostlivosť, stravu a lásku</span>
							</li>
							<li class="flex items-start gap-3">
								<span class="text-primary text-xl">✓</span>
								<span class="text-muted-foreground">Hľadáme pre každého psíka ten správny domov</span>
							</li>
							<li class="flex items-start gap-3">
								<span class="text-primary text-xl">✓</span>
								<span class="text-muted-foreground">Vzdelávame verejnosť o zodpovednom vlastníctve psov</span>
							</li>
							<li class="flex items-start gap-3">
								<span class="text-primary text-xl">✓</span>
								<span class="text-muted-foreground">Bojujeme proti týraniu a zanedbávaniu zvierat</span>
							</li>
						</ul>
					</div>
				</div>

				<div class="bg-primary/5 border border-primary/20 rounded-lg p-8 text-center">
					<p class="text-xl italic text-muted-foreground">
						Sme <strong>malý, lokálny útulok</strong> postavený na báze <strong>dobrovoľnosti, lásky k zvieratám a podpory miestnej komunity</strong>. Každá pomoc, aj tá najmenšia, má pre nás a našich psíkov obrovskú hodnotu.
					</p>
				</div>
			</div>
		</div>
	</section>

	<!-- Tím Section -->
	<section id="tim" class="tim-section">
		<div class="mx-auto max-w-7xl px-4 py-20">
			<div class="max-w-6xl mx-auto">
				<div class="text-center mb-16">
					<h2 class="text-3xl md:text-4xl font-bold mb-4">Ľudia za útulkom</h2>
					<p class="text-xl text-muted-foreground">
						Každý z nás má svoj príbeh. Spoznajte ľudí, ktorí dali útulku život a dušu.
					</p>
				</div>

				<div class="space-y-12">
					<!-- Team Member 1 -->
					<div class="bg-card border-2 border-primary/20 rounded-lg overflow-hidden">
						<div class="grid md:grid-cols-3 gap-6 p-8">
							<div class="md:col-span-1 flex flex-col items-center text-center">
								<div class="w-32 h-32 bg-muted rounded-full flex items-center justify-center mb-4">
									<div class="text-6xl">👩‍💼</div>
								</div>
								<h3 class="text-2xl font-semibold mb-1">Mgr. Petra Ožvaldová</h3>
								<p class="text-lg font-medium text-primary mb-3">Zakladateľka a vedúca</p>
								<p class="text-sm">
									<strong>Kontakt:</strong><br>
									<a href="tel:+421915785007" class="text-primary hover:underline">+421 915 785 007</a>
								</p>
							</div>
							<div class="md:col-span-2 space-y-4">
								<div>
									<h4 class="text-lg font-semibold text-primary mb-2">Môj príbeh</h4>
									<p class="text-muted-foreground leading-relaxed">
										Vždy som milovala zvieratá, ale zlom nastal, keď som na ulici našla zraneného, vyhladovaného psíka. Vtedy som si uvedomila, že chcem niečo zmeniť. V roku 2011 som založila občianske združenie a odvtedy každý deň bojujem za psíkov, ktorí to potrebujú.
									</p>
								</div>
								<div>
									<h4 class="text-lg font-semibold text-primary mb-2">Prečo to robím</h4>
									<p class="text-muted-foreground leading-relaxed">
										Každý pes si zaslúží šancu na šťastný život. Keď vidím, ako adoptovaný pes konečno nachádza domov, viem, že to má zmysel. Aj keď je to náročné, láska a vďačnosť v ich očiach stojí za všetko.
									</p>
								</div>
							</div>
						</div>
					</div>

					<!-- Team Member 2 -->
					<div class="bg-card border border-border rounded-lg overflow-hidden">
						<div class="grid md:grid-cols-3 gap-6 p-8">
							<div class="md:col-span-1 flex flex-col items-center text-center">
								<div class="w-32 h-32 bg-muted rounded-full flex items-center justify-center mb-4">
									<div class="text-6xl">👩</div>
								</div>
								<h3 class="text-2xl font-semibold mb-1">Renáta</h3>
								<p class="text-lg font-medium text-primary">Členka tímu</p>
							</div>
							<div class="md:col-span-2 space-y-4">
								<div>
									<h4 class="text-lg font-semibold text-primary mb-2">Ako som sa dostala k útulku</h4>
									<p class="text-muted-foreground leading-relaxed">
										Predtým som pracovala v úplne inom odbore, ale po adopcii môjho prvého psíka z útulku som pochopila, že chcem pomáhať aj ostatným. Začala som ako dobrovoľníčka a postupne sa to stalo mojou srdcovou záležitosťou.
									</p>
								</div>
								<div>
									<h4 class="text-lg font-semibold text-primary mb-2">Moja hodnota</h4>
									<p class="text-muted-foreground leading-relaxed">
										Verím, že každý pes má v sebe dobro a potrebuje len správneho človeka, ktorý ho prebudí. Snažím sa spájať ľudí a psíkov tak, aby to bolo šťastie na oboch stranách.
									</p>
								</div>
							</div>
						</div>
					</div>

					<!-- Team Member 3 -->
					<div class="bg-card border border-border rounded-lg overflow-hidden">
						<div class="grid md:grid-cols-3 gap-6 p-8">
							<div class="md:col-span-1 flex flex-col items-center text-center">
								<div class="w-32 h-32 bg-muted rounded-full flex items-center justify-center mb-4">
									<div class="text-6xl">👩</div>
								</div>
								<h3 class="text-2xl font-semibold mb-1">Zuzka</h3>
								<p class="text-lg font-medium text-primary">Členka tímu</p>
							</div>
							<div class="md:col-span-2 space-y-4">
								<div>
									<h4 class="text-lg font-semibold text-primary mb-2">Prečo práve útulok</h4>
									<p class="text-muted-foreground leading-relaxed">
										Odmalička som vyrastala s psami. Keď som sa dozvedela o útulku, že potrebuje pomoc, neváhala som ani chvíľu. Každý deň tráviť čas s psíkmi, starať sa o ne a vidieť ich pokroky je pre mňa nesmierne uspokojujúce.
									</p>
								</div>
								<div>
									<h4 class="text-lg font-semibold text-primary mb-2">Čo ma motivuje</h4>
									<p class="text-muted-foreground leading-relaxed">
										Pozná každého psíka v útulku po mene a poznám ich príbehy. Keď vidím, ako sa plachý, vystrašený pes postupne otvára a začína dôverovať, viem, že práca má zmysel. Láska sa vždy vráti.
									</p>
								</div>
							</div>
						</div>
					</div>

					<!-- Team Member 4 -->
					<div class="bg-card border border-border rounded-lg overflow-hidden">
						<div class="grid md:grid-cols-3 gap-6 p-8">
							<div class="md:col-span-1 flex flex-col items-center text-center">
								<div class="w-32 h-32 bg-muted rounded-full flex items-center justify-center mb-4">
									<div class="text-6xl">👨</div>
								</div>
								<h3 class="text-2xl font-semibold mb-1">Tomáš</h3>
								<p class="text-lg font-medium text-primary">Člen tímu</p>
							</div>
							<div class="md:col-span-2 space-y-4">
								<div>
									<h4 class="text-lg font-semibold text-primary mb-2">Môj príbeh</h4>
									<p class="text-muted-foreground leading-relaxed">
										Začal som pomáhať útulku s rekonštrukciou a opravami. Myslel som si, že to bude jednorazová vec, ale keď som videl, ako ťažko tím pracuje a koľko starostlivosti venuje psíkom, vedel som, že chcem zostať a pomôcť viac.
									</p>
								</div>
								<div>
									<h4 class="text-lg font-semibold text-primary mb-2">Čo ma drží pri útulku</h4>
									<p class="text-muted-foreground leading-relaxed">
										Nie som človek veľa slov, ale keď vidím, že moja práca priamo zlepšuje život psíkov - či už je to nový kotec, opravená strecha alebo len dlhá prechádzka - cítim, že mám zmysel. Psy dávajú späť čistú, bezpodmienečnú lásku.
									</p>
								</div>
							</div>
						</div>
					</div>

					<!-- Team Member 5 -->
					<div class="bg-card border border-border rounded-lg overflow-hidden">
						<div class="grid md:grid-cols-3 gap-6 p-8">
							<div class="md:col-span-1 flex flex-col items-center text-center">
								<div class="w-32 h-32 bg-muted rounded-full flex items-center justify-center mb-4">
									<div class="text-6xl">👨</div>
								</div>
								<h3 class="text-2xl font-semibold mb-1">Martin</h3>
								<p class="text-lg font-medium text-primary">Člen tímu</p>
							</div>
							<div class="md:col-span-2 space-y-4">
								<div>
									<h4 class="text-lg font-semibold text-primary mb-2">Ako som sa zapojil</h4>
									<p class="text-muted-foreground leading-relaxed">
										Som technik a vždy ma bavilo opravovať veci. Keď som zistil, že lokálny útulok má neustále technické problémy a málo financií, ponúkol som svoje služby zadarmo. Teraz sa starám, aby všetko fungovalo - od vykurovania po elektriku.
									</p>
								</div>
								<div>
									<h4 class="text-lg font-semibold text-primary mb-2">Moje presvedčenie</h4>
									<p class="text-muted-foreground leading-relaxed">
										Kvalitné zázemie znamená šťastnejšie psy. Keď viem, že psíci majú teplo v zime, čistú vodu a bezpečný priestor, cítim satisfakciu. Robím to pre nich, pretože si zaslúžia dôstojné podmienky.
									</p>
								</div>
							</div>
						</div>
					</div>
				</div>

				<!-- Team Summary -->
				<div class="mt-16 bg-primary/10 border border-primary/20 rounded-lg p-8 text-center">
					<p class="text-lg text-muted-foreground leading-relaxed">
						Každý z nás prišiel k útulku inou cestou, ale spája nás jedno - <strong class="text-primary">láska k zvieratám a presvedčenie, že každý pes si zaslúži druhú šancu</strong>. Pracujeme na dobrovoľnej báze, bez nároků na odmenu, pretože vidíme hodnotu v každom zachránenom živote.
					</p>
				</div>
			</div>
		</div>
	</section>

	<!-- Karanténna vs Útulok Section -->
	<section id="karantenna-vs-utulok" class="karantenna-vs-utulok-section bg-muted/10">
		<div class="mx-auto max-w-7xl px-4 py-20">
			<div class="max-w-5xl mx-auto">
				<h2 class="text-3xl md:text-4xl font-bold text-center mb-16">Karanténna stanica vs. Útulok</h2>
				<p class="text-xl text-center text-muted-foreground mb-12">
					Mnohí ľudia nevedia, aký je rozdiel medzi karanténnou stanicou a útulkom. Vysvetlíme vám to:
				</p>

				<div class="grid md:grid-cols-2 gap-8">
					<!-- Karanténna -->
					<div class="bg-card border-2 border-border rounded-lg p-8">
						<div class="text-5xl mb-4 text-center">🏥</div>
						<h3 class="text-2xl font-semibold mb-6 text-center">Karanténna stanica</h3>
						<p class="text-muted-foreground mb-6 leading-relaxed">
							Zariadenie, kde sú umiestnené:
						</p>
						<ul class="space-y-3 mb-6">
							<li class="flex items-start gap-3">
								<span class="text-primary">•</span>
								<span class="text-muted-foreground"><strong>Túlavé psy</strong> odchytené mestskou políciou</span>
							</li>
							<li class="flex items-start gap-3">
								<span class="text-primary">•</span>
								<span class="text-muted-foreground"><strong>Stratené psy</strong>, ktoré čakajú na svojich majiteľov</span>
							</li>
							<li class="flex items-start gap-3">
								<span class="text-primary">•</span>
								<span class="text-muted-foreground"><strong>Psy v karanténe</strong> po agresívnom správaní</span>
							</li>
						</ul>
						<div class="bg-primary/5 border-l-4 border-primary rounded-r p-4">
							<p class="text-sm text-muted-foreground">
								Psy majú <strong>povinný pobyt 14 dní</strong>. Hľadá sa ich majiteľ. Ak sa nenájde, môžu byť presunuté do útulku alebo adoptované.
							</p>
						</div>
					</div>

					<!-- Útulok -->
					<div class="bg-card border-2 border-primary rounded-lg p-8">
						<div class="text-5xl mb-4 text-center">🏠</div>
						<h3 class="text-2xl font-semibold mb-6 text-center">Útulok pre psov</h3>
						<p class="text-muted-foreground mb-6 leading-relaxed">
							Domov pre psy, ktoré:
						</p>
						<ul class="space-y-3 mb-6">
							<li class="flex items-start gap-3">
								<span class="text-primary">•</span>
								<span class="text-muted-foreground"><strong>Nemajú majiteľa</strong> alebo ich majiteľ sa o nich nechce starať</span>
							</li>
							<li class="flex items-start gap-3">
								<span class="text-primary">•</span>
								<span class="text-muted-foreground"><strong>Boli týrané alebo zanedbávané</strong></span>
							</li>
							<li class="flex items-start gap-3">
								<span class="text-primary">•</span>
								<span class="text-muted-foreground"><strong>Čakajú na adopciu</strong></span>
							</li>
						</ul>
						<div class="bg-primary/5 border-l-4 border-primary rounded-r p-4">
							<p class="text-sm text-muted-foreground">
								Psy môžu zostať <strong>tak dlho, kým nenájdu nový domov</strong>. Dostávajú veterinárnu starostlivosť, sú kastrované, očkované a pripravené na nový život.
							</p>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- Hodnoty Section -->
	<section id="hodnoty" class="hodnoty-section">
		<div class="mx-auto max-w-7xl px-4 py-20">
			<div class="max-w-6xl mx-auto">
				<h2 class="text-3xl md:text-4xl font-bold text-center mb-16">Naše hodnoty</h2>

				<div class="grid md:grid-cols-3 gap-8">
					<div class="text-center p-8 rounded-lg border-2 border-border hover:border-primary transition-colors">
						<div class="w-20 h-20 mx-auto mb-6 rounded-full bg-primary/10 flex items-center justify-center">
							<svg class="w-10 h-10 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
							</svg>
						</div>
						<h3 class="text-2xl font-semibold mb-4">Láska a rešpekt</h3>
						<p class="text-muted-foreground leading-relaxed">
							Každý pes si zaslúži lásku, dôstojné zaobchádzanie a bezpečný domov. Staráme sa o nich s úctou a súcitom.
						</p>
					</div>

					<div class="text-center p-8 rounded-lg border-2 border-border hover:border-primary transition-colors">
						<div class="w-20 h-20 mx-auto mb-6 rounded-full bg-primary/10 flex items-center justify-center">
							<svg class="w-10 h-10 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
							</svg>
						</div>
						<h3 class="text-2xl font-semibold mb-4">Transparentnosť</h3>
						<p class="text-muted-foreground leading-relaxed">
							Otvorene komunikujeme o všetkých aspektoch našej práce, financiách a rozhodnutiach. Dôvera je základ našej práce.
						</p>
					</div>

					<div class="text-center p-8 rounded-lg border-2 border-border hover:border-primary transition-colors">
