---
import MainLayout from '@/layouts/main.astro';
import NewsletterForm from '@/components/forms/NewsletterForm';
import DogImage from '@/components/DogImage.astro';
---

<MainLayout
  title="O nás"
  description="Spoznajte Trenčianský útulok, náš tím a našu misiu pomáhať opusteným a týraným psom nájsť nový domov."
>
  <!-- Hero Section -->
  <section
    id="hero"
    class="hero-section relative overflow-hidden h-[500px] flex items-center justify-center"
  >
    <!-- Background Image -->
    <div class="absolute inset-0 z-0">
      <DogImage
        src="/images/james-lacy-unsplash.jpg"
        alt="Trenčianský útulok"
        loading="eager"
        priority={true}
        aspectRatio="16/9"
        class="w-full h-full object-cover"
      />
      <div class="absolute inset-0 bg-black/50"></div>
    </div>

    <!-- Content -->
    <div class="relative z-10 mx-auto max-w-7xl px-4">
      <div class="max-w-4xl mx-auto text-center space-y-6">
        <h1 class="text-4xl md:text-6xl font-bold text-white">O nás</h1>
        <p class="text-xl md:text-2xl text-white/90 leading-relaxed">
          Od roku 2011 zachraňujeme opustené životy a tvoríme šťastné príbehy.<br />
          Spoznajte náš príbeh, tím a hodnoty, ktorými sa riadime.
        </p>
      </div>
    </div>
  </section>

  <!-- Section Separator -->
  <div class="border-t border-border/50"></div>

  <!-- História Section -->
  <section id="historia" class="historia-section py-24">
    <div class="mx-auto max-w-7xl px-4">
      <div class="grid lg:grid-cols-2 gap-16 items-center">
        <!-- Left Column: Title & Story -->
        <div class="space-y-6">
          <div class="inline-block px-4 py-2 bg-primary text-primary-foreground rounded-full">
            <span class="text-sm font-semibold">Naša cesta</span>
          </div>
          <h2 class="text-5xl lg:text-6xl font-bold tracking-tight">
            Naša história
          </h2>
          <div class="space-y-6 text-lg text-muted-foreground leading-relaxed">
            <p>
              Občianske združenie Trenčianský útulok je <strong class="text-foreground">malý, lokálny útulok</strong> s jasným cieľom - pomáhať opusteným a týraným psom v našom regióne nájsť nový domov plný lásky a starostlivosti.
            </p>
            <p>
              Od <strong class="text-primary">1. októbra 2011</strong> spravujeme karanténnu stanicu v Trenčíne. Po rozsiahlej rekonštrukcii a dostavbe sme otvorili aj útulok pre psíkov.
            </p>
            <p>
              Za tie roky sme pomohli desatkám psíkov nájsť ich „navždy domov". Každý príbeh je jedinečný, každý psík má svoj osud a my sme tu, aby sme im pomohli napísať šťastný koniec.
            </p>
          </div>
          <div class="pt-4">
            <div class="bg-gradient-to-br from-primary/10 to-accent/10 rounded-2xl p-6">
              <p class="text-xl font-semibold text-center">
                Aj malý čin pomoci má veľkú hodnotu
              </p>
            </div>
          </div>
        </div>

        <!-- Right Column: Stats & Milestones -->
        <div class="space-y-6">
          <div class="grid grid-cols-3 gap-6">
            <div class="bg-card rounded-2xl p-6 text-center shadow-lg">
              <div class="text-5xl font-bold text-primary mb-2">2011</div>
              <p class="text-sm text-muted-foreground">Rok založenia</p>
            </div>
            <div class="bg-card rounded-2xl p-6 text-center shadow-lg">
              <div class="text-5xl font-bold text-accent mb-2">30+</div>
              <p class="text-sm text-muted-foreground">Adoptovaných ročne</p>
            </div>
            <div class="bg-card rounded-2xl p-6 text-center shadow-lg">
              <div class="text-5xl font-bold text-secondary mb-2">13+</div>
              <p class="text-sm text-muted-foreground">Rokov skúseností</p>
            </div>
          </div>

          <div class="bg-card rounded-2xl p-8 shadow-xl">
            <h3 class="text-2xl font-bold mb-6">Kľúčové míľniky</h3>
            <div class="space-y-6">
              <div class="flex gap-4">
                <div class="flex-shrink-0 w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center">
                  <svg class="w-6 h-6 text-primary" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                  </svg>
                </div>
                <div>
                  <p class="font-semibold text-lg">Október 2011</p>
                  <p class="text-sm text-muted-foreground">Začiatok prevádzky karanténnej stanice</p>
                </div>
              </div>
              <div class="flex gap-4">
                <div class="flex-shrink-0 w-12 h-12 rounded-full bg-accent/10 flex items-center justify-center">
                  <svg class="w-6 h-6 text-accent" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                  </svg>
                </div>
                <div>
                  <p class="font-semibold text-lg">Rekonštrukcia</p>
                  <p class="text-sm text-muted-foreground">Rozšírenie a otvorenie útulku pre psov</p>
                </div>
              </div>
              <div class="flex gap-4">
                <div class="flex-shrink-0 w-12 h-12 rounded-full bg-secondary/10 flex items-center justify-center">
                  <svg class="w-6 h-6 text-secondary" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                  </svg>
                </div>
                <div>
                  <p class="font-semibold text-lg">Dnes</p>
                  <p class="text-sm text-muted-foreground">Aktívny útulok s desiatkami úspešných adopcií</p>
                </div>
              </div>
            </div>
          </div>

          <div class="bg-gradient-to-br from-primary/5 to-accent/5 rounded-2xl p-6">
            <p class="text-sm text-muted-foreground">
              <strong class="text-foreground">Hoci sme malý útulok</strong>, každý zachránený život má pre nás obrovskú hodnotu. Pracujeme s láskou, odhodlaním a vierou, že môžeme zmeniť svet - jedného psíka za druhým.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Section Separator -->
  <div class="border-t border-border/50"></div>

  <!-- Misia Section -->
  <section id="misia" class="misia-section bg-muted/30 py-24">
    <div class="mx-auto max-w-7xl px-4">
      <div class="grid lg:grid-cols-2 gap-16 items-center">
        <!-- Right Column: Title & Goal (appears first on mobile) -->
        <div class="space-y-6 lg:order-2">
          <div class="inline-block px-4 py-2 bg-accent text-accent-foreground rounded-full">
            <span class="text-sm font-semibold">Náš účel</span>
          </div>
          <h2 class="text-5xl lg:text-6xl font-bold tracking-tight">
            Naša misia
          </h2>
          <p class="text-2xl font-semibold text-foreground leading-relaxed">
            Pomôcť nájsť domov opusteným a týraným psom
          </p>
          <p class="text-xl text-muted-foreground leading-relaxed">
            Veríme, že každý pes si zaslúži druhú šancu, lásku a bezpečie. Pracujeme na tom každý deň s odhodlaním a láskou.
          </p>

          <div class="pt-6">
            <div class="bg-gradient-to-br from-accent/10 to-primary/10 rounded-2xl p-8">
              <p class="text-lg leading-relaxed">
                Sme <strong class="text-foreground">malý, lokálny útulok</strong> postavený na báze dobrovoľnosti, lásky k zvieratám a podpory miestnej komunity. Každá pomoc, aj tá najmenšia, má pre nás obrovskú hodnotu.
              </p>
            </div>
          </div>
        </div>

        <!-- Left Column: What We Do (appears second on mobile, first on desktop) -->
        <div class="space-y-6 lg:order-1">
          <div class="bg-card rounded-2xl p-8 shadow-xl">
            <h3 class="text-2xl font-bold mb-6">Čo robíme</h3>
            <div class="space-y-5">
              <div class="flex items-start gap-4">
                <div class="flex-shrink-0 w-10 h-10 rounded-full bg-primary/10 flex items-center justify-center">
                  <svg class="w-6 h-6 text-primary" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                  </svg>
                </div>
                <div>
                  <p class="font-semibold text-lg">Kvalitné útočisko</p>
                  <p class="text-sm text-muted-foreground">Pre opustené a týrané psy v našom regióne</p>
                </div>
              </div>

              <div class="flex items-start gap-4">
                <div class="flex-shrink-0 w-10 h-10 rounded-full bg-accent/10 flex items-center justify-center">
                  <svg class="w-6 h-6 text-accent" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                  </svg>
                </div>
                <div>
                  <p class="font-semibold text-lg">Veterinárna starostlivosť</p>
                  <p class="text-sm text-muted-foreground">Zdravotná starostlivosť, strava a láska</p>
                </div>
              </div>

              <div class="flex items-start gap-4">
                <div class="flex-shrink-0 w-10 h-10 rounded-full bg-secondary/10 flex items-center justify-center">
                  <svg class="w-6 h-6 text-secondary" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                  </svg>
                </div>
                <div>
                  <p class="font-semibold text-lg">Hľadanie domova</p>
                  <p class="text-sm text-muted-foreground">Pre každého psíka ten správny, láskavý domov</p>
                </div>
              </div>

              <div class="flex items-start gap-4">
                <div class="flex-shrink-0 w-10 h-10 rounded-full bg-primary/10 flex items-center justify-center">
                  <svg class="w-6 h-6 text-primary" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                  </svg>
                </div>
                <div>
                  <p class="font-semibold text-lg">Vzdelávanie</p>
                  <p class="text-sm text-muted-foreground">O zodpovednom vlastníctve a starostlivosti</p>
                </div>
              </div>

              <div class="flex items-start gap-4">
                <div class="flex-shrink-0 w-10 h-10 rounded-full bg-accent/10 flex items-center justify-center">
                  <svg class="w-6 h-6 text-accent" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                  </svg>
                </div>
                <div>
                  <p class="font-semibold text-lg">Ochrana zvierat</p>
                  <p class="text-sm text-muted-foreground">Bojujeme proti týraniu a zanedbávaniu</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Section Separator -->
  <div class="border-t border-border/50"></div>

  <!-- Tím Section -->
  <section id="tim" class="tim-section py-24">
    <div class="mx-auto max-w-7xl px-4">
      <div class="max-w-5xl mx-auto">
        <div class="text-center mb-16 space-y-4">
          <div class="inline-block px-4 py-2 bg-primary text-primary-foreground rounded-full">
            <span class="text-sm font-semibold">Náš tím</span>
          </div>
          <h2 class="text-4xl md:text-5xl font-bold">Ľudia za útulkom</h2>
          <p class="text-xl text-muted-foreground max-w-2xl mx-auto">
            Skupina dobrovoľníkov spojená láskou k zvieratám
          </p>
        </div>

        <!-- Founder -->
        <div class="bg-gradient-to-br from-primary/5 to-accent/5 rounded-2xl p-8 mb-12 max-w-3xl mx-auto">
          <div class="text-center space-y-4">
            <div class="w-24 h-24 bg-primary/10 rounded-full flex items-center justify-center mx-auto">
              <svg class="w-12 h-12 text-primary" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 9a3 3 0 100-6 3 3 0 000 6zm-7 9a7 7 0 1114 0H3z" clip-rule="evenodd"/>
              </svg>
            </div>
            <div>
              <h3 class="text-2xl font-bold mb-1">Mgr. Petra Ožvaldová</h3>
              <p class="text-lg text-primary font-medium mb-4">Zakladateľka a vedúca</p>
              <p class="text-muted-foreground leading-relaxed max-w-xl mx-auto">
                V roku 2011 som založila občianske združenie s cieľom pomáhať opusteným psom. Každý pes si zaslúži druhú šancu na šťastný život.
              </p>
              <div class="mt-6">
                <a href="tel:+421915785007" class="inline-flex items-center gap-2 text-primary hover:underline font-medium">
                  <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
                    <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z"/>
                  </svg>
                  +421 915 785 007
                </a>
              </div>
            </div>
          </div>
        </div>

        <!-- Team Grid -->
        <div class="grid md:grid-cols-2 gap-8">
          <div class="bg-card rounded-2xl p-8 shadow-sm">
            <div class="flex items-start gap-6">
              <div class="w-20 h-20 bg-accent/10 rounded-full flex items-center justify-center shrink-0">
                <svg class="w-10 h-10 text-accent" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 9a3 3 0 100-6 3 3 0 000 6zm-7 9a7 7 0 1114 0H3z" clip-rule="evenodd"/>
                </svg>
              </div>
              <div class="flex-1">
                <h3 class="text-xl font-bold mb-1">Renáta</h3>
                <p class="text-sm text-accent font-medium mb-3">Adopcie a sociálne siete</p>
                <p class="text-sm text-muted-foreground italic leading-relaxed">
                  "Verím, že každý pes má v sebe dobro a potrebuje len správneho človeka. Snažím sa spájať ľudí a psíkov tak, aby to bolo šťastie na oboch stranách."
                </p>
              </div>
            </div>
          </div>

          <div class="bg-card rounded-2xl p-8 shadow-sm">
            <div class="flex items-start gap-6">
              <div class="w-20 h-20 bg-secondary/10 rounded-full flex items-center justify-center shrink-0">
                <svg class="w-10 h-10 text-secondary" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 9a3 3 0 100-6 3 3 0 000 6zm-7 9a7 7 0 1114 0H3z" clip-rule="evenodd"/>
                </svg>
              </div>
              <div class="flex-1">
                <h3 class="text-xl font-bold mb-1">Zuzka</h3>
                <p class="text-sm text-secondary font-medium mb-3">Denná starostlivosť</p>
                <p class="text-sm text-muted-foreground italic leading-relaxed">
                  "Poznám každého psíka v útulku po mene a ich príbehy. Keď vidím, ako sa plachý pes postupne otvára a začína dôverovať, viem, že to má zmysel."
                </p>
              </div>
            </div>
          </div>

          <div class="bg-card rounded-2xl p-8 shadow-sm">
            <div class="flex items-start gap-6">
              <div class="w-20 h-20 bg-primary/10 rounded-full flex items-center justify-center shrink-0">
                <svg class="w-10 h-10 text-primary" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 9a3 3 0 100-6 3 3 0 000 6zm-7 9a7 7 0 1114 0H3z" clip-rule="evenodd"/>
                </svg>
              </div>
              <div class="flex-1">
                <h3 class="text-xl font-bold mb-1">Tomáš</h3>
                <p class="text-sm text-primary font-medium mb-3">Rekonštrukcie a opravy</p>
                <p class="text-sm text-muted-foreground italic leading-relaxed">
                  "Keď vidím, že moja práca priamo zlepšuje život psíkov - či už je to nový kotec alebo len dlhá prechádzka - cítim, že to má zmysel. Psy dávajú späť čistú lásku."
                </p>
              </div>
            </div>
          </div>

          <div class="bg-card rounded-2xl p-8 shadow-sm">
            <div class="flex items-start gap-6">
              <div class="w-20 h-20 bg-accent/10 rounded-full flex items-center justify-center shrink-0">
                <svg class="w-10 h-10 text-accent" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 9a3 3 0 100-6 3 3 0 000 6zm-7 9a7 7 0 1114 0H3z" clip-rule="evenodd"/>
                </svg>
              </div>
              <div class="flex-1">
                <h3 class="text-xl font-bold mb-1">Martin</h3>
                <p class="text-sm text-accent font-medium mb-3">Technická prevádzka</p>
                <p class="text-sm text-muted-foreground italic leading-relaxed">
                  "Kvalitné zázemie znamená šťastnejšie psy. Keď viem, že psíci majú teplo v zime, čistú vodu a bezpečný priestor, cítim satisfakciu."
                </p>
              </div>
            </div>
          </div>
        </div>

        <!-- Team Message -->
        <div class="mt-12 text-center max-w-2xl mx-auto">
          <p class="text-lg text-muted-foreground leading-relaxed">
            Pracujeme na dobrovoľnej báze s jediným cieľom – <strong class="text-foreground">pomôcť každému psíkovi nájsť nový domov plný lásky</strong>.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Section Separator -->
  <div class="border-t border-border/50"></div>

  <!-- Karanténna vs Útulok Section -->
  <section id="karantenna-vs-utulok" class="karantenna-vs-utulok-section bg-muted/30 py-24">
    <div class="mx-auto max-w-7xl px-4">
      <div class="max-w-5xl mx-auto">
        <div class="text-center mb-16 space-y-4">
          <div class="inline-block px-4 py-2 bg-secondary text-secondary-foreground rounded-full">
            <span class="text-sm font-semibold">Dôležité rozdiely</span>
          </div>
          <h2 class="text-4xl md:text-5xl font-bold">
            Karanténna stanica vs. Útulok
          </h2>
          <p class="text-xl text-muted-foreground max-w-2xl mx-auto">
            Mnohí ľudia nevedia, aký je rozdiel. Vysvetlíme vám to jednoducho.
          </p>
        </div>

        <div class="grid md:grid-cols-2 gap-8">
          <!-- Karanténna -->
          <div class="bg-card rounded-2xl p-8 shadow-lg">
            <div class="w-20 h-20 bg-secondary/10 rounded-full flex items-center justify-center mx-auto mb-6">
              <svg class="w-10 h-10 text-secondary" fill="currentColor" viewBox="0 0 20 20">
                <path d="M10.394 2.08a1 1 0 00-.788 0l-7 3a1 1 0 000 1.84L5.25 8.051a.999.999 0 01.356-.257l4-1.714a1 1 0 11.788 1.838L7.667 9.088l1.94.831a1 1 0 00.787 0l7-3a1 1 0 000-1.838l-7-3zM3.31 9.397L5 10.12v4.102a8.969 8.969 0 00-1.05-.174 1 1 0 01-.89-.89 11.115 11.115 0 01.25-3.762zM9.3 16.573A9.026 9.026 0 007 14.935v-3.957l1.818.78a3 3 0 002.364 0l5.508-2.361a11.026 11.026 0 01.25 3.762 1 1 0 01-.89.89 8.968 8.968 0 00-5.35 2.524 1 1 0 01-1.4 0zM6 18a1 1 0 001-1v-2.065a8.935 8.935 0 00-2-.712V17a1 1 0 001 1z"/>
              </svg>
            </div>
            <h3 class="text-2xl font-bold mb-6 text-center">Karanténna stanica</h3>
            <p class="text-muted-foreground mb-6">Zariadenie, kde sú umiestnené:</p>
            <div class="space-y-4 mb-6">
              <div class="flex items-start gap-3">
                <svg class="w-5 h-5 text-secondary mt-0.5 shrink-0" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                </svg>
                <span><strong>Túlavé psy</strong> odchytené mestskou políciou</span>
              </div>
              <div class="flex items-start gap-3">
                <svg class="w-5 h-5 text-secondary mt-0.5 shrink-0" fill="currentColor" viewBox="0 0 20 20">
