---
import MainLayout from '@/layouts/main.astro';
---

<MainLayout title="Adopcia" description="Chcete adoptovať psíka z Trenčianskeho útulku? Zistite, ako prebieha adopcia, čo potrebujete a aké sú dôležité informácie pred adopciou.">
	<!-- Hero Section -->
	<section id="hero" class="hero-section relative overflow-hidden h-[500px] flex items-center justify-center">
		<!-- Background Image -->
		<div class="absolute inset-0 z-0">
			<img
				src="/images/anna-dudkova-unsplash.jpg"
				alt="Adoptujte psíka"
				class="w-full h-full object-cover"
			/>
			<div class="absolute inset-0 bg-black/50"></div>
		</div>

		<!-- Content -->
		<div class="relative z-10 mx-auto max-w-7xl px-4">
			<div class="max-w-4xl mx-auto text-center space-y-6">
				<h1 class="text-4xl md:text-6xl font-bold text-white">Adopcia psíka</h1>
				<p class="text-xl md:text-2xl text-white/90 leading-relaxed max-w-3xl mx-auto">
					Rozhodnutie adoptovať psíka je jedným z najkrajších rozhodnutí, aké môžete urobiť. Dávate opustenému zvieraťu druhú šancu na šťastný život a získavate verného kamaráta na celý život.
				</p>
			</div>
		</div>
	</section>

	<!-- Prečo adoptovať Section -->
	<section id="why-adopt" class="py-24 border-t border-border/50">
		<div class="mx-auto max-w-7xl px-4">
			<div class="grid lg:grid-cols-2 gap-12 items-center">
				<!-- Left: Content -->
				<div class="space-y-6">
					<div class="inline-block px-4 py-2 bg-primary text-primary-foreground rounded-full">
						<span class="text-sm font-semibold">Prečo adoptovať</span>
					</div>
					<h2 class="text-4xl md:text-5xl font-bold tracking-tight leading-tight">
						Zachráňte život a získajte verného kamaráta
					</h2>
					<p class="text-xl text-muted-foreground leading-relaxed">
						Každá adopcia znamená druhú šancu pre opusteného psíka. Psy z útulkov sú mimoriadne vďačné a lojálne, a adopciou pomáhate nielen jednému zvieraťu, ale vytvárate miesto pre ďalšieho záchraneného psíka.
					</p>
					<a href="/blog" class="inline-flex items-center gap-2 text-primary hover:underline font-medium">
						<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
							<path fill-rule="evenodd" d="M12.586 4.586a2 2 0 112.828 2.828l-3 3a2 2 0 01-2.828 0 1 1 0 00-1.414 1.414 4 4 0 005.656 0l3-3a4 4 0 00-5.656-5.656l-1.5 1.5a1 1 0 101.414 1.414l1.5-1.5zm-5 5a2 2 0 012.828 0 1 1 0 101.414-1.414 4 4 0 00-5.656 0l-3 3a4 4 0 105.656 5.656l1.5-1.5a1 1 0 10-1.414-1.414l-1.5 1.5a2 2 0 11-2.828-2.828l3-3z" clip-rule="evenodd"/>
						</svg>
						Prečítajte si príbehy našich adoptovaných psíkov
					</a>
				</div>

				<!-- Right: Benefits Grid -->
				<div class="grid gap-6">
					<div class="bg-gradient-to-br from-primary/5 to-accent/5 rounded-2xl p-6 shadow-sm">
						<div class="flex items-start gap-4">
							<div class="w-12 h-12 bg-primary text-primary-foreground rounded-xl flex items-center justify-center shrink-0">
								<svg class="w-6 h-6" fill="currentColor" viewBox="0 0 20 20">
									<path d="M3.172 5.172a4 4 0 015.656 0L10 6.343l1.172-1.171a4 4 0 115.656 5.656L10 17.657l-6.828-6.829a4 4 0 010-5.656z"/>
								</svg>
							</div>
							<div>
								<h3 class="text-xl font-bold mb-2">Zachránite život</h3>
								<p class="text-muted-foreground">Každá adopcia dáva psíkovi druhú šancu na šťastný život v milujúcom domove</p>
							</div>
						</div>
					</div>

					<div class="bg-gradient-to-br from-accent/5 to-secondary/5 rounded-2xl p-6 shadow-sm">
						<div class="flex items-start gap-4">
							<div class="w-12 h-12 bg-accent text-accent-foreground rounded-xl flex items-center justify-center shrink-0">
								<svg class="w-6 h-6" fill="currentColor" viewBox="0 0 20 20">
									<path fill-rule="evenodd" d="M6.267 3.455a3.066 3.066 0 001.745-.723 3.066 3.066 0 013.976 0 3.066 3.066 0 001.745.723 3.066 3.066 0 012.812 2.812c.051.643.304 1.254.723 1.745a3.066 3.066 0 010 3.976 3.066 3.066 0 00-.723 1.745 3.066 3.066 0 01-2.812 2.812 3.066 3.066 0 00-1.745.723 3.066 3.066 0 01-3.976 0 3.066 3.066 0 00-1.745-.723 3.066 3.066 0 01-2.812-2.812 3.066 3.066 0 00-.723-1.745 3.066 3.066 0 010-3.976 3.066 3.066 0 00.723-1.745 3.066 3.066 0 012.812-2.812zm7.44 5.252a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
								</svg>
							</div>
							<div>
								<h3 class="text-xl font-bold mb-2">Kompletná starostlivosť</h3>
								<p class="text-muted-foreground">Všetci naši psíci sú odčervení, odblšení, očkovaní, kastrovaní a čipovaní</p>
							</div>
						</div>
					</div>

					<div class="bg-gradient-to-br from-secondary/5 to-primary/5 rounded-2xl p-6 shadow-sm">
						<div class="flex items-start gap-4">
							<div class="w-12 h-12 bg-secondary text-secondary-foreground rounded-xl flex items-center justify-center shrink-0">
								<svg class="w-6 h-6" fill="currentColor" viewBox="0 0 20 20">
									<path fill-rule="evenodd" d="M4 4a2 2 0 00-2 2v4a2 2 0 002 2V6h10a2 2 0 00-2-2H4zm2 6a2 2 0 012-2h8a2 2 0 012 2v4a2 2 0 01-2 2H8a2 2 0 01-2-2v-4zm6 4a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd"/>
								</svg>
							</div>
							<div>
								<h3 class="text-xl font-bold mb-2">Oslobodenie od dane</h3>
								<p class="text-muted-foreground">V meste Trenčín sú adopteri oslobodení od dane za psa</p>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- 7 otázok Section -->
	<section id="questions" class="py-24 border-t border-border/50 bg-gradient-to-br from-amber-50/50 to-orange-50/50 dark:from-amber-950/20 dark:to-orange-950/20">
		<div class="mx-auto max-w-7xl px-4">
			<div class="grid lg:grid-cols-2 gap-12 items-center lg:order-2">
				<!-- Right: Content -->
				<div class="space-y-6 lg:order-2">
					<div class="inline-block px-4 py-2 bg-amber-600 text-white rounded-full">
						<span class="text-sm font-semibold">Dôležité otázky</span>
					</div>
					<h2 class="text-4xl md:text-5xl font-bold tracking-tight leading-tight">
						Pred adopciou si zodpovedajte úprimne
					</h2>
					<p class="text-xl text-muted-foreground leading-relaxed">
						Adopcia je celoživotný záväzok. Prejdite si týchto 7 kľúčových otázok, ktoré vám pomôžu rozhodnúť sa, či ste pripravení na nového štvornohého člena rodiny.
					</p>
				</div>

				<!-- Left: Questions List -->
				<div class="space-y-4 lg:order-1">
					<div class="bg-card rounded-2xl p-6 shadow-sm">
						<div class="flex items-start gap-4">
							<div class="w-10 h-10 bg-amber-100 dark:bg-amber-900/30 text-amber-600 dark:text-amber-400 rounded-full flex items-center justify-center shrink-0 font-bold">
								1
							</div>
							<div>
								<h3 class="font-bold mb-1">Súhlasí so zaobstaraním psíka celá rodina?</h3>
								<p class="text-sm text-muted-foreground">Pes je spoločný člen rodiny a všetci musia súhlasiť.</p>
							</div>
						</div>
					</div>

					<div class="bg-card rounded-2xl p-6 shadow-sm">
						<div class="flex items-start gap-4">
							<div class="w-10 h-10 bg-amber-100 dark:bg-amber-900/30 text-amber-600 dark:text-amber-400 rounded-full flex items-center justify-center shrink-0 font-bold">
								2
							</div>
							<div>
								<h3 class="font-bold mb-1">Máte náhradné riešenie?</h3>
								<p class="text-sm text-muted-foreground">Kto sa postará o psíka počas vašej neprítomnosti?</p>
							</div>
						</div>
					</div>

					<div class="bg-card rounded-2xl p-6 shadow-sm">
						<div class="flex items-start gap-4">
							<div class="w-10 h-10 bg-amber-100 dark:bg-amber-900/30 text-amber-600 dark:text-amber-400 rounded-full flex items-center justify-center shrink-0 font-bold">
								3
							</div>
							<div>
								<h3 class="font-bold mb-1">Budete schopní venovať čas?</h3>
								<p class="text-sm text-muted-foreground">Denne aspoň 1-2 hodiny na prechádzkach a starostlivosti.</p>
							</div>
						</div>
					</div>

					<div class="bg-card rounded-2xl p-6 shadow-sm">
						<div class="flex items-start gap-4">
							<div class="w-10 h-10 bg-amber-100 dark:bg-amber-900/30 text-amber-600 dark:text-amber-400 rounded-full flex items-center justify-center shrink-0 font-bold">
								4
							</div>
							<div>
								<h3 class="font-bold mb-1">Ako ste na tom s čistotou?</h3>
								<p class="text-sm text-muted-foreground">Psy prinášajú špinu, srsť a potrebujú pravidelnú starostlivosť.</p>
							</div>
						</div>
					</div>

					<div class="bg-card rounded-2xl p-6 shadow-sm">
						<div class="flex items-start gap-4">
							<div class="w-10 h-10 bg-amber-100 dark:bg-amber-900/30 text-amber-600 dark:text-amber-400 rounded-full flex items-center justify-center shrink-0 font-bold">
								5
							</div>
							<div>
								<h3 class="font-bold mb-1">Dáte psíkovi čas na adaptáciu?</h3>
								<p class="text-sm text-muted-foreground">Psík potrebuje týždne až mesiace na zabývanie a príjem návykov.</p>
							</div>
						</div>
					</div>

					<div class="bg-card rounded-2xl p-6 shadow-sm">
						<div class="flex items-start gap-4">
							<div class="w-10 h-10 bg-amber-100 dark:bg-amber-900/30 text-amber-600 dark:text-amber-400 rounded-full flex items-center justify-center shrink-0 font-bold">
								6
							</div>
							<div>
								<h3 class="font-bold mb-1">Máte finančné prostriedky?</h3>
								<p class="text-sm text-muted-foreground">Mesačné náklady (krmivo, veterinár): 30-100 €.</p>
							</div>
						</div>
					</div>

					<div class="bg-card rounded-2xl p-6 shadow-sm">
						<div class="flex items-start gap-4">
							<div class="w-10 h-10 bg-amber-100 dark:bg-amber-900/30 text-amber-600 dark:text-amber-400 rounded-full flex items-center justify-center shrink-0 font-bold">
								7
							</div>
							<div>
								<h3 class="font-bold mb-1">Máte finančné rezervy?</h3>
								<p class="text-sm text-muted-foreground">Na vážnejšie ochorenia, operácie a neočakávané výdavky.</p>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- Ako prebieha adopcia Section -->
	<section id="process" class="py-24 border-t border-border/50">
		<div class="mx-auto max-w-7xl px-4">
			<!-- Section Header -->
			<div class="text-center max-w-3xl mx-auto mb-16">
				<div class="inline-block px-4 py-2 bg-primary text-primary-foreground rounded-full mb-6">
					<span class="text-sm font-semibold">Proces adopcie</span>
				</div>
				<h2 class="text-5xl lg:text-6xl font-bold tracking-tight mb-6">
					Ako prebieha adopcia?
				</h2>
				<p class="text-xl text-muted-foreground leading-relaxed">
					Adopcia u nás je jednoduchý a transparentný proces, ktorý zabezpečuje, že každý psík nájde ten správny domov.
				</p>
			</div>

			<!-- Process Steps -->
			<div class="space-y-24">
				<!-- Step 1: Navštívte útulok -->
				<div class="grid lg:grid-cols-2 gap-12 items-center">
					<div class="space-y-6">
						<div class="flex items-center gap-4">
							<div class="w-16 h-16 bg-primary text-primary-foreground rounded-2xl flex items-center justify-center shrink-0 font-bold text-2xl shadow-lg">
								1
							</div>
							<h3 class="text-3xl md:text-4xl font-bold">Navštívte útulok</h3>
						</div>
						<p class="text-xl text-muted-foreground leading-relaxed">
							Príďte k nám počas otváracích hodín (Po-Ne 10:00-16:00) a spoznajte našich psíkov osobne. Prechádzajte sa medzi kotercami, pozorovajte ich správanie a možno vás niektorý osloví.
						</p>
						<div class="bg-gradient-to-br from-primary/5 to-accent/5 rounded-2xl p-6">
							<h4 class="font-bold mb-2">Užitočný tip</h4>
							<p class="text-muted-foreground">Odporúčame prísť viackrát, aby ste spoznali psíka v rôznych náladách a situáciách.</p>
						</div>
					</div>
					<div class="bg-gradient-to-br from-primary/10 to-accent/10 rounded-2xl p-12 text-center">
						<svg class="w-32 h-32 mx-auto text-primary" fill="currentColor" viewBox="0 0 20 20">
							<path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd"/>
						</svg>
						<p class="text-lg font-semibold mt-4">Útulok Trenčín</p>
						<p class="text-muted-foreground">Po-Ne 10:00-16:00</p>
					</div>
				</div>

				<!-- Step 2: Vyberte si psíka -->
				<div class="grid lg:grid-cols-2 gap-12 items-center">
					<div class="bg-gradient-to-br from-accent/10 to-secondary/10 rounded-2xl p-12 text-center lg:order-1">
						<svg class="w-32 h-32 mx-auto text-accent" fill="currentColor" viewBox="0 0 20 20">
							<path d="M3.172 5.172a4 4 0 015.656 0L10 6.343l1.172-1.171a4 4 0 115.656 5.656L10 17.657l-6.828-6.829a4 4 0 010-5.656z"/>
						</svg>
						<p class="text-lg font-semibold mt-4">Nájdite svojho parťáka</p>
						<p class="text-muted-foreground">Vyberte si psíka podľa srdca</p>
					</div>
					<div class="space-y-6 lg:order-2">
						<div class="flex items-center gap-4">
							<div class="w-16 h-16 bg-accent text-accent-foreground rounded-2xl flex items-center justify-center shrink-0 font-bold text-2xl shadow-lg">
								2
							</div>
							<h3 class="text-3xl md:text-4xl font-bold">Vyberte si psíka</h3>
						</div>
						<p class="text-xl text-muted-foreground leading-relaxed">
							Zobrať si psíka na prechádzku, zistiť, či vám vyhovuje jeho povaha a energia. Každý pes je iný a dôležité je nájsť správny match medzi vami a psíkom.
						</p>
						<a href="/psici" class="inline-flex items-center gap-2 text-primary hover:underline font-medium">
							<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
								<path d="M11 3a1 1 0 100 2h2.586l-6.293 6.293a1 1 0 101.414 1.414L15 6.414V9a1 1 0 102 0V4a1 1 0 00-1-1h-5z"/>
								<path d="M5 5a2 2 0 00-2 2v8a2 2 0 002 2h8a2 2 0 002-2v-3a1 1 0 10-2 0v3H5V7h3a1 1 0 000-2H5z"/>
							</svg>
							Pozrite si našich psíkov k adopcii
						</a>
					</div>
				</div>

				<!-- Step 3: Poraďte sa s nami -->
				<div class="grid lg:grid-cols-2 gap-12 items-center">
					<div class="space-y-6">
						<div class="flex items-center gap-4">
							<div class="w-16 h-16 bg-secondary text-secondary-foreground rounded-2xl flex items-center justify-center shrink-0 font-bold text-2xl shadow-lg">
								3
							</div>
							<h3 class="text-3xl md:text-4xl font-bold">Poraďte sa s nami</h3>
						</div>
						<p class="text-xl text-muted-foreground leading-relaxed">
							Pracovníci útulku vám radi poradia, aký typ psíka by vám vyhovoval podľa vašich podmienok, skúseností a životného štýlu. Poznáme každého psíka a vieme odporučiť toho pravého.
						</p>
						<div class="bg-gradient-to-br from-secondary/5 to-primary/5 rounded-2xl p-6">
							<h4 class="font-bold mb-2">Máme skúsenosti</h4>
							<p class="text-muted-foreground">Poznáme povahu každého psíka a pomôžeme vám nájsť vášho ideálneho spoločníka.</p>
						</div>
					</div>
					<div class="bg-gradient-to-br from-secondary/10 to-primary/10 rounded-2xl p-12 text-center">
						<svg class="w-32 h-32 mx-auto text-secondary" fill="currentColor" viewBox="0 0 20 20">
							<path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-8-3a1 1 0 00-.867.5 1 1 0 11-1.731-1A3 3 0 0113 8a3.001 3.001 0 01-2 2.83V11a1 1 0 11-2 0v-1a1 1 0 011-1 1 1 0 100-2zm0 8a1 1 0 100-2 1 1 0 000 2z" clip-rule="evenodd"/>
						</svg>
						<p class="text-lg font-semibold mt-4">Odborná pomoc</p>
						<p class="text-muted-foreground">Poradíme vám s výberom</p>
					</div>
				</div>

				<!-- Step 4: Vyplňte dotazník -->
				<div class="grid lg:grid-cols-2 gap-12 items-center">
					<div class="bg-gradient-to-br from-primary/10 to-accent/10 rounded-2xl p-12 text-center lg:order-1">
						<svg class="w-32 h-32 mx-auto text-primary" fill="currentColor" viewBox="0 0 20 20">
							<path fill-rule="evenodd" d="M4 4a2 2 0 012-2h4.586A2 2 0 0112 2.586L15.414 6A2 2 0 0116 7.414V16a2 2 0 01-2 2H6a2 2 0 01-2-2V4zm2 6a1 1 0 011-1h6a1 1 0 110 2H7a1 1 0 01-1-1zm1 3a1 1 0 100 2h6a1 1 0 100-2H7z" clip-rule="evenodd"/>
						</svg>
						<p class="text-lg font-semibold mt-4">Adopčný dotazník</p>
						<p class="text-muted-foreground">Pomôže nám zabezpečiť správny domov</p>
					</div>
					<div class="space-y-6 lg:order-2">
						<div class="flex items-center gap-4">
							<div class="w-16 h-16 bg-primary text-primary-foreground rounded-2xl flex items-center justify-center shrink-0 font-bold text-2xl shadow-lg">
								4
							</div>
							<h3 class="text-3xl md:text-4xl font-bold">Vyplňte dotazník</h3>
						</div>
						<p class="text-xl text-muted-foreground leading-relaxed">
							Pred adopciou je potrebné vyplniť dotazník o podmienkach, ktoré psíkovi ponúkate. Pomáha nám to zabezpečiť, že každý psík nájde vhodný domov, kde bude šťastný.
						</p>
						<div class="flex flex-wrap gap-3">
							<div class="bg-card px-4 py-2 rounded-full border border-border text-sm">
								<span class="text-muted-foreground">Bývanie</span>
							</div>
							<div class="bg-card px-4 py-2 rounded-full border border-border text-sm">
								<span class="text-muted-foreground">Skúsenosti</span>
							</div>
							<div class="bg-card px-4 py-2 rounded-full border border-border text-sm">
								<span class="text-muted-foreground">Voľný čas</span>
							</div>
							<div class="bg-card px-4 py-2 rounded-full border border-border text-sm">
								<span class="text-muted-foreground">Finančné možnosti</span>
							</div>
						</div>
					</div>
				</div>

				<!-- Step 5: Adopcia -->
				<div class="grid lg:grid-cols-2 gap-12 items-center">
					<div class="space-y-6">
						<div class="flex items-center gap-4">
							<div class="w-16 h-16 bg-accent text-accent-foreground rounded-2xl flex items-center justify-center shrink-0 font-bold text-2xl shadow-lg">
								5
							</div>
							<h3 class="text-3xl md:text-4xl font-bold">Podpis zmluvy a adopcia</h3>
						</div>
						<p class="text-xl text-muted-foreground leading-relaxed">
							Po schválení dotazníka podpíšete adopčnú zmluvu a zaplatíte adopčný poplatok. Budete potrebovať občiansky preukaz, obojok, vodítko a náhubok.
						</p>
						<div class="bg-gradient-to-br from-accent/5 to-secondary/5 rounded-2xl p-6 space-y-4">
							<div class="flex items-start gap-3">
								<svg class="w-6 h-6 text-accent shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
