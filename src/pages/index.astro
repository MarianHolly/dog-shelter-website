---
import MainLayout from '@/layouts/main.astro';
import { getCollection } from 'astro:content';
import FeaturedDogsCarousel from '@/components/FeaturedDogsCarousel';
import TestimonialsCarousel from '@/components/TestimonialsCarousel';
import CarePlusHero from '@/components/hero/CarePlusHero';
import AnimatedCounter from '@/components/stats/AnimatedCounter';
import ServiceCard from '@/components/cards/ServiceCard';

// Get featured dogs
const allDogs = await getCollection('dogs');
const featuredDogs = allDogs
	.filter(dog => dog.data.featured || dog.data.urgent)
	.sort((a, b) => {
		if (a.data.urgent && !b.data.urgent) return -1;
		if (!a.data.urgent && b.data.urgent) return 1;
		return 0;
	})
	.slice(0, 6);

// Get testimonials
const allTestimonials = await getCollection('testimonials');
const featuredTestimonials = allTestimonials
	.filter(t => t.data.featured)
	.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<MainLayout title="Domov" description="Nekupuj, adoptuj si psíka od nás. Pomáhame opusteným a týraným psom nájsť ich nový domov.">
	<!-- Hero Section - CarePlus Style -->
	<div class="-mt-16">
		<CarePlusHero
			client:load
			title="Nekupuj, adoptuj si psíka od nás"
			subtitle="Trenčiansky útulok pre psov"
			description="Vitajte v Trenčianskom útulku! Sme občianske združenie, ktoré sa už viac ako 13 rokov stará o opustených a týraných psíkov v Trenčíne. Každý z našich psíkov si zaslúži druhú šancu a láskyplný domov."
			primaryCta={{ text: "Pozrite si našich psíkov", href: "/psici" }}
			secondaryCta={{ text: "Ako adoptovať", href: "/adopcia" }}
			heroImage="/images/sasha-sashina-1-unsplash.jpg"
			badge="Už viac ako 13 rokov pomáhame"
		/>
	</div>

	<!-- Featured Dogs Carousel Section -->
	{featuredDogs.length > 0 && (
		<section id="featured-dogs" class="animate-on-scroll featured-dogs-section section-spacing-lg bg-muted/20">
			<div class="mx-auto max-w-7xl container-spacing">
				<div class="text-center mb-12 md:mb-16">
					<h2 class="text-3xl md:text-4xl lg:text-5xl font-bold tracking-tight mb-4">Vybrané psíky</h2>
					<p class="text-lg text-muted-foreground max-w-2xl mx-auto leading-relaxed">
						Títo úžasní psíci hľadajú nový domov. Každý z nich si zaslúži lásku a starostlivosť.
					</p>
				</div>
				<FeaturedDogsCarousel dogs={featuredDogs} client:load />
				<div class="text-center mt-12">
					<a
						href="/psici"
						class="inline-flex items-center justify-center px-8 py-4 rounded-md bg-primary text-primary-foreground hover:bg-primary/90 transition-colors font-semibold text-lg shadow-sm"
					>
						Pozrite si všetkých psíkov →
					</a>
				</div>
			</div>
		</section>
	)}

	<!-- About + Stats Combined Section - Animal Cove Style -->
	<section id="about" class="animate-on-scroll about-section section-spacing">
		<div class="mx-auto max-w-7xl container-spacing">
			<!-- Intro Text -->
			<div class="text-center mb-16">
				<h2 class="text-4xl md:text-5xl lg:text-6xl font-bold tracking-tight mb-6">Kto sme</h2>
				<div class="w-20 h-1 bg-primary mx-auto mb-8"></div>
				<div class="max-w-3xl mx-auto">
					<p class="text-lg md:text-xl leading-relaxed text-foreground/90 mb-4">
						Sme malé občianske združenie hlboko zakorenené v trenčianskej komunite. Od roku 2011 sa staráme o opustených a týraných psíkov s láskou a osobným prístupom.
					</p>
					<p class="text-lg leading-relaxed text-muted-foreground">
						U nás nie ste len číslo – každý pes má svoj príbeh a každý adoptér sa stáva súčasťou našej rodiny dobrovoľníkov, podporovateľov a priateľov zvierat.
					</p>
				</div>
			</div>

			<!-- Stats with Images - Animal Cove Style -->
			<div class="grid md:grid-cols-3 gap-8 md:gap-10">
				<!-- Stat 1 with Image -->
				<div class="group relative overflow-hidden rounded-2xl bg-card shadow-minimal hover:shadow-minimal-lg transition-all">
					<!-- Image -->
					<div class="aspect-4/3 overflow-hidden">
						<img 
							src="/images/madeline-bowen-unsplash.jpg" 
							alt="Zachránené psy" 
							class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
							loading="lazy"
						/>
					</div>
					<!-- Stat Overlay -->
					<div class="absolute inset-0 bg-linear-to-t from-background via-background/80 to-transparent flex items-end">
						<div class="p-6 md:p-8 w-full">
							<div class="text-5xl md:text-6xl font-extrabold text-primary mb-2">
								500+
							</div>
							<div class="text-base md:text-lg font-medium text-foreground">
								Psíkov našlo nový domov
							</div>
						</div>
					</div>
				</div>

				<!-- Stat 2 with Image -->
				<div class="group relative overflow-hidden rounded-2xl bg-card shadow-minimal hover:shadow-minimal-lg transition-all">
					<!-- Image -->
					<div class="aspect-4/3 overflow-hidden">
						<img
							src="/images/jana-shnipelson-unsplash.jpg"
							alt="Šťastné rodiny"
							class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
							loading="lazy"
						/>
					</div>
					<!-- Stat Overlay -->
					<div class="absolute inset-0 bg-linear-to-t from-background via-background/80 to-transparent flex items-end">
						<div class="p-6 md:p-8 w-full">
							<div class="text-5xl md:text-6xl font-extrabold text-primary mb-2">
								98%
							</div>
							<div class="text-base md:text-lg font-medium text-foreground">
								Spokojnosť adoptérov
							</div>
						</div>
					</div>
				</div>

				<!-- Stat 3 with Image -->
				<div class="group relative overflow-hidden rounded-2xl bg-card shadow-minimal hover:shadow-minimal-lg transition-all">
					<!-- Image -->
					<div class="aspect-4/3 overflow-hidden">
						<img
							src="/images/michael-kucharski-unsplash.jpg"
							alt="Roky skúseností"
							class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
							loading="lazy"
						/>
					</div>
					<!-- Stat Overlay -->
					<div class="absolute inset-0 bg-linear-to-t from-background via-background/80 to-transparent flex items-end">
						<div class="p-6 md:p-8 w-full">
							<div class="text-5xl md:text-6xl font-extrabold text-primary mb-2">
								13+
							</div>
							<div class="text-base md:text-lg font-medium text-foreground">
								Rokov pomáhame
							</div>
						</div>
					</div>
				</div>
			</div>

			<!-- CTA -->
			<div class="text-center mt-12">
				<a href="/o-nas" class="inline-flex items-center gap-2 text-primary hover:text-primary/80 font-semibold transition-colors text-lg">
					Zistite viac o nás
					<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
					</svg>
				</a>
			</div>
		</div>
	</section>

	<!-- Principles Section -->
	<section id="principles" class="animate-on-scroll principles-section section-spacing bg-muted/20">
		<div class="mx-auto max-w-7xl container-spacing">
			<div class="text-center mb-12 md:mb-16">
				<h2 class="text-3xl md:text-4xl lg:text-5xl font-bold tracking-tight mb-4">Naše hodnoty</h2>
				<p class="text-lg text-muted-foreground max-w-3xl mx-auto leading-relaxed">
					Čo nás robí výnimočnými a prečo sme viac ako len útulok
				</p>
			</div>
			<div class="max-w-7xl mx-auto">
				<div class="grid md:grid-cols-3 gap-8 md:gap-10">
					<ServiceCard
						client:load
						iconName="Home"
						title="Osobný prístup"
						description="Malý útulok, veľké srdce. Poznáme každého psíka osobne, jeho povahu a potreby. Pomôžeme vám nájsť toho pravého štvornohého kamaráta."
						delay={0}
					/>
					<ServiceCard
						client:load
						iconName="Users"
						title="Inkluzívna komunita"
						description="Každý môže pomôcť – adoptéri, sponzori, dobrovoľníci, zdieľači príbehov. Spoločne tvoríme rodinu ľudí, ktorým záleží na osudoch psíkov."
						delay={0.1}
					/>
					<ServiceCard
						client:load
						iconName="Heart"
						title="Transparentnosť"
						description="Zdieľame príbehy našich psíkov, ich pokroky aj výzvy. Staňte sa súčasťou ich životov a sledujte ich cestu k novému domovu."
						delay={0.2}
					/>
				</div>
			</div>
		</div>
	</section>

	<!-- Testimonials Section -->
	{featuredTestimonials.length > 0 && (
		<section id="testimonials" class="animate-on-scroll testimonials-section section-spacing-lg bg-muted/20">
			<div class="mx-auto max-w-7xl container-spacing">
				<div class="text-center mb-12 md:mb-16">
					<h2 class="text-3xl md:text-4xl lg:text-5xl font-bold tracking-tight mb-4">Príbehy šťastných rodín</h2>
					<p class="text-lg text-muted-foreground max-w-2xl mx-auto leading-relaxed">
						Prečítajte si, čo hovoria ľudia, ktorí si adoptovali psíka z nášho útulku
					</p>
					<div class="flex items-center justify-center gap-2 mt-4">
						<div class="flex gap-1 text-yellow-500 text-xl">
							★★★★★
						</div>
						<span class="text-muted-foreground">
							{featuredTestimonials.length}+ šťastných rodín
						</span>
					</div>
				</div>
				<TestimonialsCarousel testimonials={featuredTestimonials} client:load />
			</div>
		</section>
	)}

	<!-- Team Section - Our Passionate Team Style -->
	<section id="team" class="animate-on-scroll team-section section-spacing bg-muted/20">
		<div class="mx-auto max-w-7xl container-spacing">
			<div class="text-center mb-12 md:mb-16">
				<h2 class="text-3xl md:text-4xl lg:text-5xl font-bold tracking-tight mb-4">Náš tím</h2>
				<p class="text-lg text-muted-foreground max-w-3xl mx-auto leading-relaxed">
					Spoznajte ľudí, ktorí sa každý deň starajú o našich psíkov s láskou a odhodlaním
				</p>
			</div>

			<div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-8 max-w-6xl mx-auto">
				<!-- Team Member 1 -->
				<div class="group">
					<!-- Image -->
					<div class="relative mb-5 overflow-hidden rounded-2xl aspect-square bg-linear-to-br from-primary/10 to-accent/10 shadow-minimal hover:shadow-minimal-lg transition-shadow">
						<!-- Placeholder for photo -->
						<div class="absolute inset-0 flex items-center justify-center text-muted-foreground/30">
							<svg class="w-24 h-24" fill="currentColor" viewBox="0 0 24 24">
								<path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/>
							</svg>
						</div>
						<!-- Replace with: <img src="/images/team/member-1.jpg" alt="Anna Nováková" class="w-full h-full object-cover" /> -->
					</div>

					<!-- Info -->
					<div class="text-center space-y-2">
						<h3 class="text-xl font-bold">Anna Nováková</h3>
						<p class="text-sm text-muted-foreground font-medium">Zakladateľka & Vedúca útulku</p>

						<!-- Social Links -->
						<div class="flex items-center justify-center gap-3 pt-2">
							<a href="#" class="w-8 h-8 rounded-full bg-primary/10 hover:bg-primary/20 text-primary flex items-center justify-center transition-colors" aria-label="Facebook">
								<svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
									<path d="M18 2h-3a5 5 0 00-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 011-1h3z"/>
								</svg>
							</a>
							<a href="#" class="w-8 h-8 rounded-full bg-primary/10 hover:bg-primary/20 text-primary flex items-center justify-center transition-colors" aria-label="Instagram">
								<svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
									<rect width="20" height="20" x="2" y="2" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1112.63 8 4 4 0 0116 11.37zm1.5-4.87h.01"/>
								</svg>
							</a>
						</div>
					</div>
				</div>

				<!-- Team Member 2 -->
				<div class="group">
					<div class="relative mb-5 overflow-hidden rounded-2xl aspect-square bg-linear-to-br from-accent/10 to-secondary/20 shadow-minimal hover:shadow-minimal-lg transition-shadow">
						<div class="absolute inset-0 flex items-center justify-center text-muted-foreground/30">
							<svg class="w-24 h-24" fill="currentColor" viewBox="0 0 24 24">
								<path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/>
							</svg>
						</div>
					</div>
					<div class="text-center space-y-2">
						<h3 class="text-xl font-bold">Petra Králová</h3>
						<p class="text-sm text-muted-foreground font-medium">Veterinárna asistentka</p>
						<div class="flex items-center justify-center gap-3 pt-2">
							<a href="#" class="w-8 h-8 rounded-full bg-primary/10 hover:bg-primary/20 text-primary flex items-center justify-center transition-colors" aria-label="Facebook">
								<svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
									<path d="M18 2h-3a5 5 0 00-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 011-1h3z"/>
								</svg>
							</a>
							<a href="#" class="w-8 h-8 rounded-full bg-primary/10 hover:bg-primary/20 text-primary flex items-center justify-center transition-colors" aria-label="Instagram">
								<svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
									<rect width="20" height="20" x="2" y="2" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1112.63 8 4 4 0 0116 11.37zm1.5-4.87h.01"/>
								</svg>
							</a>
						</div>
					</div>
				</div>

				<!-- Team Member 3 -->
				<div class="group">
					<div class="relative mb-5 overflow-hidden rounded-2xl aspect-square bg-linear-to-br from-secondary/20 to-primary/10 shadow-minimal hover:shadow-minimal-lg transition-shadow">
						<div class="absolute inset-0 flex items-center justify-center text-muted-foreground/30">
							<svg class="w-24 h-24" fill="currentColor" viewBox="0 0 24 24">
								<path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/>
							</svg>
						</div>
					</div>
					<div class="text-center space-y-2">
						<h3 class="text-xl font-bold">Marián Horváth</h3>
						<p class="text-sm text-muted-foreground font-medium">Koordinátor adopcií</p>
						<div class="flex items-center justify-center gap-3 pt-2">
							<a href="#" class="w-8 h-8 rounded-full bg-primary/10 hover:bg-primary/20 text-primary flex items-center justify-center transition-colors" aria-label="Facebook">
								<svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
									<path d="M18 2h-3a5 5 0 00-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 011-1h3z"/>
								</svg>
							</a>
							<a href="#" class="w-8 h-8 rounded-full bg-primary/10 hover:bg-primary/20 text-primary flex items-center justify-center transition-colors" aria-label="Instagram">
								<svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
									<rect width="20" height="20" x="2" y="2" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1112.63 8 4 4 0 0116 11.37zm1.5-4.87h.01"/>
								</svg>
							</a>
						</div>
					</div>
				</div>

				<!-- Team Member 4 -->
				<div class="group">
					<div class="relative mb-5 overflow-hidden rounded-2xl aspect-square bg-linear-to-br from-primary/10 to-secondary/20 shadow-minimal hover:shadow-minimal-lg transition-shadow">
						<div class="absolute inset-0 flex items-center justify-center text-muted-foreground/30">
							<svg class="w-24 h-24" fill="currentColor" viewBox="0 0 24 24">
								<path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/>
							</svg>
						</div>
					</div>
					<div class="text-center space-y-2">
						<h3 class="text-xl font-bold">Lucia Svobodová</h3>
						<p class="text-sm text-muted-foreground font-medium">Koordinátorka dobrovoľníkov</p>
						<div class="flex items-center justify-center gap-3 pt-2">
							<a href="#" class="w-8 h-8 rounded-full bg-primary/10 hover:bg-primary/20 text-primary flex items-center justify-center transition-colors" aria-label="Facebook">
								<svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
									<path d="M18 2h-3a5 5 0 00-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 011-1h3z"/>
								</svg>
							</a>
							<a href="#" class="w-8 h-8 rounded-full bg-primary/10 hover:bg-primary/20 text-primary flex items-center justify-center transition-colors" aria-label="Instagram">
								<svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
									<rect width="20" height="20" x="2" y="2" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1112.63 8 4 4 0 0116 11.37zm1.5-4.87h.01"/>
								</svg>
							</a>
						</div>
					</div>
				</div>
			</div>

			<!-- CTA to volunteer -->
			<div class="text-center mt-12">
				<p class="text-muted-foreground mb-4">
					Chcete sa pridať k nášmu tímu?
				</p>
				<a href="/ako-pomoct#dobrovolnictvo" class="inline-flex items-center gap-2 text-primary hover:text-primary/80 font-semibold transition-colors text-lg">
					Staňte sa dobrovoľníkom
					<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
					</svg>
				</a>
			</div>
		</div>
	</section>

	<!-- Why Adopt - Merged Section -->
	<section id="why-adopt" class="animate-on-scroll why-adopt-section section-spacing-lg">
		<div class="mx-auto max-w-7xl container-spacing">
			<div class="text-center mb-16">
				<h2 class="text-3xl md:text-4xl lg:text-5xl font-bold tracking-tight mb-4">Prečo adoptovať z útulku?</h2>
				<p class="text-lg text-muted-foreground max-w-3xl mx-auto leading-relaxed">
					Adopcia je rozhodnutie, ktoré zmení životy - váš aj života psíka. Prinášame vám všetky dôvody a výhody adopcie z nášho útulku.
				</p>
			</div>

			<!-- General Benefits -->
			<div class="max-w-6xl mx-auto mb-20">
				<h3 class="text-2xl md:text-3xl font-bold text-center mb-12">Všeobecné dôvody pre adopciu</h3>
				<div class="grid md:grid-cols-3 gap-8 md:gap-10">
					<div class="p-8 md:p-10 rounded-xl bg-card border border-border shadow-minimal-hover text-center transition-all hover:shadow-minimal-lg">
						<div class="text-5xl mb-4">🐾</div>
						<h4 class="text-xl font-semibold mb-4">Záchrana života</h4>
						<p class="text-muted-foreground leading-relaxed">
							Adopciou dáte opustenému psíkovi druhú šancu na šťastný život. Zachránite život a získate verného kamaráta, ktorý vám to bude vďačný každý deň.
						</p>
					</div>
					<div class="p-8 md:p-10 rounded-xl bg-card border border-border shadow-minimal-hover text-center transition-all hover:shadow-minimal-lg">
						<div class="text-5xl mb-4">❤️</div>
						<h4 class="text-xl font-semibold mb-4">Vďačný kamarát</h4>
						<p class="text-muted-foreground leading-relaxed">
							Získate verného spoločníka na celý život, ktorý vám dá nekonečnú lásku a radosť. Psíci z útulku si svoju druhú šancu naplno vážia.
						</p>
					</div>
					<div class="p-8 md:p-10 rounded-xl bg-card border border-border shadow-minimal-hover text-center transition-all hover:shadow-minimal-lg">
						<div class="text-5xl mb-4">🌍</div>
						<h4 class="text-xl font-semibold mb-4">Zodpovedné vlastníctvo</h4>
						<p class="text-muted-foreground leading-relaxed">
							Adoptovaním zo sheltra bojujete proti nelegálnym chovateľom a zvyšujete povedomie o zodpovednom vlastníctve psov.
						</p>
					</div>
				</div>
			</div>

			<!-- Our Specific Advantages - Compact Centered Style -->
			<div class="max-w-6xl mx-auto">
