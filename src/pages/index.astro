---
import MainLayout from '@/layouts/main.astro';
---

<MainLayout title="Domov" description="Nekupuj, adoptuj si psíka od nás. Pomáhame opusteným a týraným psom nájsť ich nový domov.">
	<!-- Hero Section -->
	<section id="hero" class="hero-section relative overflow-hidden h-screen -mt-16">
		<!-- Background Image with Overlay -->
		<div class="absolute inset-0 z-0">
			<img
				src="/images/sasha-sashina-unsplash.jpg"
				alt="Šťastný pes"
				loading="eager"
				fetchpriority="high"
				width="1920"
				height="1080"
				class="w-full h-full object-cover"
			/>
			<div class="absolute inset-0 bg-background/80 dark:bg-background/85"></div>
		</div>

		<!-- Content -->
		<div class="relative z-10 mx-auto max-w-screen-2xl px-4 h-full">
			<div class="flex h-full flex-col items-center justify-center gap-8 text-center pt-16">
				<h1 class="text-5xl md:text-6xl lg:text-7xl xl:text-8xl font-bold tracking-tight leading-none">Nekupuj, adoptuj si psíka od nás</h1>
				<p class="text-lg md:text-xl lg:text-2xl text-foreground/90 max-w-3xl leading-relaxed">
					Vitajte v Trenčianskom útulku! Sme občianske združenie, ktoré sa už viac ako 13 rokov stará o opustených a týraných psíkov v Trenčíne. Každý z našich psíkov si zaslúži druhú šancu a láskyplný domov.
				</p>
				<div class="flex flex-col sm:flex-row gap-4 mt-6">
					<a href="/psici" class="inline-flex items-center justify-center px-8 py-4 rounded-md bg-primary text-primary-foreground hover:bg-primary/90 transition-colors font-semibold text-lg shadow-lg">
						Pozrite si našich psíkov
					</a>
					<a href="/adopcia" class="inline-flex items-center justify-center px-8 py-4 rounded-md bg-secondary text-secondary-foreground hover:bg-secondary/90 transition-colors font-semibold text-lg shadow-lg">
						Ako adoptovať
					</a>
				</div>
			</div>
		</div>
	</section>

	<!-- About Section -->
	<section id="about" class="about-section section-spacing">
		<div class="mx-auto max-w-screen-2xl container-spacing">
			<div class="max-w-3xl mx-auto text-center">
				<h2 class="text-4xl md:text-5xl lg:text-6xl font-bold uppercase tracking-wider mb-6">Kto sme</h2>
				<div class="w-20 h-1 bg-primary mx-auto mb-8"></div>
				<p class="text-lg md:text-xl leading-relaxed text-foreground/90">
					Sme malé občianske združenie hlboko zakorenené v trenčianskej komunite. Od roku 2011 sa staráme o opustených a týraných psíkov s láskou a osobným prístupom. U nás nie ste len číslo – každý pes má svoj príbeh a každý adoptér sa stáva súčasťou našej rodiny dobrovoľníkov, podporovateľov a priateľov zvierat.
				</p>
			</div>
		</div>
	</section>

	<!-- Principles Section -->
	<section id="principles" class="principles-section section-spacing">
		<div class="mx-auto max-w-screen-2xl container-spacing">
			<div class="max-w-6xl mx-auto">
				<div class="grid md:grid-cols-3 gap-8 md:gap-12">
					<!-- Principle 1: Personal Approach -->
					<div class="text-center p-8 md:p-10 rounded-lg shadow-minimal-hover">
						<div class="text-6xl mb-6">🏡</div>
						<h3 class="text-2xl font-bold mb-4 tracking-tight">Osobný prístup</h3>
						<p class="text-muted-foreground leading-relaxed">
							Malý útulok, veľké srdce. Poznáme každého psíka osobne, jeho povahu a potreby. Pomôžeme vám nájsť toho pravého štvornohého kamaráta.
						</p>
					</div>

					<!-- Principle 2: Inclusive Community -->
					<div class="text-center p-8 md:p-10 rounded-lg shadow-minimal-hover">
						<div class="text-6xl mb-6">🤝</div>
						<h3 class="text-2xl font-bold mb-4 tracking-tight">Inkluzívna komunita</h3>
						<p class="text-muted-foreground leading-relaxed">
							Každý môže pomôcť – adoptéri, sponzori, dobrovoľníci, zdieľači príbehov. Spoločne tvoríme rodinu ľudí, ktorým záleží na osudoch psíkov.
						</p>
					</div>

					<!-- Principle 3: Transparency -->
					<div class="text-center p-8 md:p-10 rounded-lg shadow-minimal-hover">
						<div class="text-6xl mb-6">💙</div>
						<h3 class="text-2xl font-bold mb-4 tracking-tight">Transparentnosť</h3>
						<p class="text-muted-foreground leading-relaxed">
							Zdieľame príbehy našich psíkov, ich pokroky aj výzvy. Staňte sa súčasťou ich životov a sledujte ich cestu k novému domovu.
						</p>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- Stats Section -->
	<section id="stats" class="stats-section section-spacing">
		<div class="mx-auto max-w-screen-2xl container-spacing">
			<div class="grid grid-cols-1 md:grid-cols-3 gap-8 md:gap-12 max-w-5xl mx-auto">
				<div class="text-center p-8 md:p-12 rounded-lg shadow-minimal-hover">
					<div class="text-6xl md:text-7xl font-bold text-primary mb-4">500+</div>
					<div class="text-lg text-muted-foreground leading-relaxed">Psíkov našlo nový domov</div>
				</div>
				<div class="text-center p-8 md:p-12 rounded-lg shadow-minimal-hover">
					<div class="text-6xl md:text-7xl font-bold text-primary mb-4">13</div>
					<div class="text-lg text-muted-foreground leading-relaxed">Rokov pomáhame</div>
				</div>
				<div class="text-center p-8 md:p-12 rounded-lg shadow-minimal-hover">
					<div class="text-6xl md:text-7xl font-bold text-primary mb-4">24/7</div>
					<div class="text-lg text-muted-foreground leading-relaxed">Starostlivosť o psíkov</div>
				</div>
			</div>
		</div>
	</section>

	<!-- Quick Image Gallery -->
	<section id="gallery" class="gallery-section section-spacing">
		<div class="mx-auto max-w-screen-2xl container-spacing">
			<div class="text-center mb-12 md:mb-16">
				<h2 class="text-3xl md:text-4xl lg:text-5xl font-bold tracking-tight mb-4">Naši psíci hľadajú domov</h2>
				<p class="text-lg text-muted-foreground max-w-2xl mx-auto leading-relaxed">Zoznámte sa s našimi nádherným štvornohými priateľmi</p>
			</div>
			<div class="grid grid-cols-2 md:grid-cols-4 gap-6 md:gap-8">
				<div class="overflow-hidden rounded-lg shadow-minimal-hover group">
					<img
						src="/images/madeline-bowen-unsplash.jpg"
						alt="Pes čakajúci na adopciu"
						class="w-full h-64 object-cover group-hover:scale-105 transition-transform duration-300"
						loading="lazy"
						width="400"
						height="256"
					/>
				</div>
				<div class="overflow-hidden rounded-lg shadow-minimal-hover group">
					<img
						src="/images/michael-kucharski-unsplash.jpg"
						alt="Pes čakajúci na adopciu"
						class="w-full h-64 object-cover group-hover:scale-105 transition-transform duration-300"
						loading="lazy"
						width="400"
						height="256"
					/>
				</div>
				<div class="overflow-hidden rounded-lg shadow-minimal-hover group">
					<img
						src="/images/jana-shnipelson-KnzXzvRqTFE-unsplash.jpg"
						alt="Pes čakajúci na adopciu"
						class="w-full h-64 object-cover group-hover:scale-105 transition-transform duration-300"
						loading="lazy"
						width="400"
						height="256"
					/>
				</div>
				<div class="overflow-hidden rounded-lg shadow-minimal-hover group">
					<img
						src="/images/sasha-sashina-Xcscr_sNSEY-unsplash.jpg"
						alt="Pes čakajúci na adopciu"
						class="w-full h-64 object-cover group-hover:scale-105 transition-transform duration-300"
						loading="lazy"
						width="400"
						height="256"
					/>
				</div>
			</div>
		</div>
	</section>

	<!-- Why Adopt Section - Part 1: General Benefits -->
	<section id="why-adopt" class="why-adopt-section section-spacing-lg">
		<div class="mx-auto max-w-screen-2xl container-spacing">
			<div class="max-w-5xl mx-auto">
				<h2 class="text-3xl md:text-4xl lg:text-5xl font-bold text-center mb-16 tracking-tight">Prečo adoptovať?</h2>
				<div class="grid md:grid-cols-3 gap-8 md:gap-10">
					<div class="p-8 md:p-10 rounded-lg shadow-minimal-hover text-center">
						<div class="text-5xl mb-4">🐾</div>
						<h3 class="text-2xl font-semibold mb-4">Záchrana života</h3>
						<p class="text-muted-foreground leading-relaxed">
							Adopciou dáte opustenému psíkovi druhú šancu na šťastný život. Zachránite život a získate verného kamaráta, ktorý vám to bude vďačný každý deň.
						</p>
					</div>
					<div class="p-8 md:p-10 rounded-lg shadow-minimal-hover text-center">
						<div class="text-5xl mb-4">❤️</div>
						<h3 class="text-2xl font-semibold mb-4">Vďačný kamarát</h3>
						<p class="text-muted-foreground leading-relaxed">
							Získate verného spoločníka na celý život, ktorý vám dá nekonečnú lásku a radosť. Psíci z útulku si svoju druhú šancu naplno vážia.
						</p>
					</div>
					<div class="p-8 md:p-10 rounded-lg shadow-minimal-hover text-center">
						<div class="text-5xl mb-4">🌍</div>
						<h3 class="text-2xl font-semibold mb-4">Zodpovedné vlastníctvo</h3>
						<p class="text-muted-foreground leading-relaxed">
							Adoptovaním zo sheltra bojujete proti nelegálnym chovateľom a zvyšujete povedomie o zodpovednom vlastníctve psov.
						</p>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- Why Adopt Section - Part 2: Our Advantages -->
	<section id="why-adopt-us" class="why-adopt-us-section section-spacing-lg">
		<div class="mx-auto max-w-screen-2xl container-spacing">
			<div class="max-w-6xl mx-auto">
				<h2 class="text-3xl md:text-4xl lg:text-5xl font-bold text-center mb-4 tracking-tight">Prečo adoptovať U NÁS?</h2>
				<p class="text-lg text-muted-foreground text-center max-w-3xl mx-auto mb-16 leading-relaxed">
					Naše služby a zodpovedný prístup zabezpečia úspešnú adopciu
				</p>
				<div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8 md:gap-10">
					<div class="p-8 md:p-10 rounded-lg shadow-minimal-hover text-center">
						<div class="text-5xl mb-4">💉</div>
						<h3 class="text-2xl font-semibold mb-4">Kompletná starostlivosť</h3>
						<p class="text-muted-foreground leading-relaxed">
							Všetci naši psíci sú odčervení, odblšení, očkovaní, začipovaní a kastrovaní. Dostanete zdravého psíka pripraveného na nový domov.
						</p>
					</div>
					<div class="p-8 md:p-10 rounded-lg shadow-minimal-hover text-center">
						<div class="text-5xl mb-4">🤝</div>
						<h3 class="text-2xl font-semibold mb-4">Osobný prístup</h3>
						<p class="text-muted-foreground leading-relaxed">
							Malý útulok znamená, že poznáme každého psíka osobne. Pomôžeme vám vybrať psíka, ktorý vám bude vyhovovať podľa životného štýlu.
						</p>
					</div>
					<div class="p-8 md:p-10 rounded-lg shadow-minimal-hover text-center">
						<div class="text-5xl mb-4">💰</div>
						<h3 class="text-2xl font-semibold mb-4">Oslobodenie od dane</h3>
						<p class="text-muted-foreground leading-relaxed">
							V meste Trenčín neplatíte daň za adoptovaného psíka z útulku. Ušetríte náklady a zároveň pomôžete dobrej veci.
						</p>
					</div>
					<div class="p-8 md:p-10 rounded-lg shadow-minimal-hover text-center">
						<div class="text-5xl mb-4">📋</div>
						<h3 class="text-2xl font-semibold mb-4">Podpora aj po adopcii</h3>
						<p class="text-muted-foreground leading-relaxed">
							Poradíme vám s adaptáciou a budeme vás podporovať aj po adopcii. Nie ste sami – sme tu pre vás a vášho psíka.
						</p>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- Support Section -->
	<section id="support" class="support-section section-spacing-lg">
		<div class="mx-auto max-w-screen-2xl container-spacing">
			<div class="max-w-6xl mx-auto">
				<div class="text-center mb-16">
					<h2 class="text-3xl md:text-4xl lg:text-5xl font-bold mb-6 tracking-tight">Ako nás môžete podporiť</h2>
					<p class="text-lg text-muted-foreground max-w-3xl mx-auto leading-relaxed">
						Aj keď momentálne nemôžete adoptovať, existuje množstvo spôsobov, ako sa môžete stať súčasťou našej komunity a pomôcť našim psíkom
					</p>
				</div>

				<div class="grid md:grid-cols-2 gap-12 md:gap-16">
					<!-- Financial Support -->
					<div>
						<h3 class="text-2xl font-bold mb-8 text-center md:text-left">Finančná podpora</h3>
						<div class="space-y-4">
							<a href="/ako-pomoct#financny-prispevok" class="block p-6 rounded-lg shadow-minimal-hover transition-all hover:shadow-minimal-lg group">
								<div class="flex items-center gap-4">
									<div class="text-4xl flex-shrink-0">💰</div>
									<div class="text-left">
										<div class="font-semibold text-foreground text-lg group-hover:text-primary transition-colors">Finančný príspevok</div>
										<div class="text-sm text-muted-foreground mt-1">Jednorazový alebo pravidel</div>
									</div>
								</div>
							</a>
							<a href="/ako-pomoct#2-z-dani" class="block p-6 rounded-lg shadow-minimal-hover transition-all hover:shadow-minimal-lg group">
								<div class="flex items-center gap-4">
									<div class="text-4xl flex-shrink-0">💙</div>
									<div class="text-left">
										<div class="font-semibold text-foreground text-lg group-hover:text-primary transition-colors">2% z daní</div>
										<div class="text-sm text-muted-foreground mt-1">Venujte nám 2% z vašej dane</div>
									</div>
								</div>
							</a>
							<a href="/ako-pomoct#virtualna-adopcia" class="block p-6 rounded-lg shadow-minimal-hover transition-all hover:shadow-minimal-lg group">
								<div class="flex items-center gap-4">
									<div class="text-4xl flex-shrink-0">🐕</div>
									<div class="text-left">
										<div class="font-semibold text-foreground text-lg group-hover:text-primary transition-colors">Virtuálna adopcia</div>
										<div class="text-sm text-muted-foreground mt-1">Mesačné sponzorstvo konkrétneho psíka</div>
									</div>
								</div>
							</a>
						</div>
					</div>

					<!-- Active Support -->
					<div>
						<h3 class="text-2xl font-bold mb-8 text-center md:text-left">Aktívna pomoc</h3>
						<div class="space-y-4">
							<a href="/ako-pomoct#dobrovolnictvo" class="block p-6 rounded-lg shadow-minimal-hover transition-all hover:shadow-minimal-lg group">
								<div class="flex items-center gap-4">
									<div class="text-4xl flex-shrink-0">🤝</div>
									<div class="text-left">
										<div class="font-semibold text-foreground text-lg group-hover:text-primary transition-colors">Dobrovoľníctvo</div>
										<div class="text-sm text-muted-foreground mt-1">Venujte nám svoj čas a energiu</div>
									</div>
								</div>
							</a>
							<a href="/ako-pomoct#krmivo" class="block p-6 rounded-lg shadow-minimal-hover transition-all hover:shadow-minimal-lg group">
								<div class="flex items-center gap-4">
									<div class="text-4xl flex-shrink-0">🎁</div>
									<div class="text-left">
										<div class="font-semibold text-foreground text-lg group-hover:text-primary transition-colors">Dary a potreby</div>
										<div class="text-sm text-muted-foreground mt-1">Krmivo, deky, hračky a ostatné potreby</div>
									</div>
								</div>
							</a>
							<a href="/ako-pomoct" class="block p-6 rounded-lg shadow-minimal-hover transition-all hover:shadow-minimal-lg group">
								<div class="flex items-center gap-4">
									<div class="text-4xl flex-shrink-0">📢</div>
									<div class="text-left">
										<div class="font-semibold text-foreground text-lg group-hover:text-primary transition-colors">Zdieľanie</div>
										<div class="text-sm text-muted-foreground mt-1">Šírte povedomie o našich psíkoch</div>
									</div>
								</div>
							</a>
						</div>
					</div>
				</div>

				<div class="text-center mt-12">
					<a href="/ako-pomoct" class="inline-flex items-center justify-center px-8 py-4 rounded-md bg-primary text-primary-foreground hover:bg-primary/90 transition-colors font-semibold shadow-sm">
						Všetky možnosti podpory →
					</a>
				</div>
			</div>
		</div>
	</section>

	<!-- Find Us Section -->
	<section id="find-us" class="find-us-section section-spacing-lg">
		<div class="mx-auto max-w-screen-2xl container-spacing">
			<div class="text-center mb-16">
				<h2 class="text-3xl md:text-4xl lg:text-5xl font-bold mb-6 tracking-tight">Ako nás nájdete</h2>
				<p class="text-lg text-muted-foreground max-w-2xl mx-auto leading-relaxed">
					Navštívte nás a spoznajte našich psíkov osobne
				</p>
			</div>

			<div class="max-w-6xl mx-auto grid md:grid-cols-2 gap-12 md:gap-16">
				<!-- Contact Information -->
				<div class="space-y-8">
					<div>
						<div class="flex items-start gap-4 mb-4">
							<div class="text-3xl">📍</div>
							<div>
								<h3 class="text-xl font-bold mb-2">Adresa</h3>
								<p class="text-muted-foreground leading-relaxed">
									Brnianska 2480<br>
									911 05 Trenčín - Zlatovce
								</p>
								<p class="text-sm text-muted-foreground mt-2">
									GPS: 48°53'05.2″N 18°00'22.9″E
								</p>
							</div>
						</div>
					</div>

					<div>
						<div class="flex items-start gap-4 mb-4">
							<div class="text-3xl">🕐</div>
							<div>
								<h3 class="text-xl font-bold mb-2">Otváracie hodiny</h3>
								<p class="text-muted-foreground leading-relaxed">
									Pondelok - Nedeľa<br>
									<span class="text-lg font-semibold text-foreground">10:00 - 16:00</span>
								</p>
							</div>
						</div>
					</div>

					<div>
						<div class="flex items-start gap-4 mb-4">
							<div class="text-3xl">📞</div>
							<div>
								<h3 class="text-xl font-bold mb-2">Kontakt</h3>
								<p class="text-muted-foreground leading-relaxed">
									<a href="tel:+421915785007" class="hover:text-primary transition-colors font-medium">
										+421 915 785 007
									</a><br>
									<a href="mailto:utulok.trencin@gmail.com" class="hover:text-primary transition-colors">
										utulok.trencin@gmail.com
									</a>
								</p>
							</div>
						</div>
