					<div class="pt-4">
						<a href="/kontakt" class="inline-flex items-center justify-center px-8 py-4 rounded-md bg-primary text-primary-foreground hover:bg-primary/90 transition-colors font-semibold shadow-sm w-full md:w-auto">
							Kompletné informácie →
						</a>
					</div>
				</div>

				<!-- Visual / Map -->
				<div class="flex items-center justify-center">
					<div class="w-full h-full min-h-[400px] rounded-lg shadow-minimal-lg overflow-hidden bg-muted/20 flex items-center justify-center">
						<!-- Placeholder for map or image -->
						<div class="text-center p-8">
							<div class="text-6xl mb-4">🗺️</div>
							<p class="text-muted-foreground">
								<a href="https://maps.google.com/?q=48.884778,18.006361" target="_blank" rel="noopener noreferrer" class="text-primary hover:text-primary/80 font-semibold">
									Zobraziť na Google Maps →
								</a>
							</p>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>
</MainLayout>
