# Web3Forms — contact and adoption inquiry forms
# Get your free key at https://web3forms.com
PUBLIC_WEB3FORMS_KEY=your_web3forms_access_key

# MailerLite — newsletter subscriptions (server-side only, never expose in client code)
# Get your API key at https://app.mailerlite.com/integrations/api/
MAILERLITE_API_KEY=your_mailerlite_api_key
# Group ID from MailerLite dashboard (Subscribers → Groups → copy the numeric ID)
MAILERLITE_GROUP_ID=your_mailerlite_group_id

# Netlify Identity — auth for the /admin Decap CMS (git-gateway backend).
# This site is hosted on Cloudflare Pages, so Identity/Git Gateway run on a
# separate, otherwise-empty Netlify site created just for auth. See CMS_SETUP.md.
# URL of that Netlify site, e.g. https://your-utulok-identity.netlify.app
PUBLIC_NETLIFY_IDENTITY_URL=https://your-identity-site.netlify.app
